# 当前数据采集使用的高德 Web 服务 key（不运行采集脚本时可留空）
AMAP_REST_KEY=

# 地图页面使用的高德 JS API
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# PostgreSQL
DATABASE_URL=postgres://schoolpath:schoolpath_dev_password@localhost:15432/schoolpath

# 固定导入接口鉴权（外部采集/导入项目 POST /api/ingest/records 的 x-ingest-token 头）
# 未配置时接口返回 503（视为未启用）
INGEST_TOKEN=
