# See https://help.github.com/articles/ignoring-files/ for more about ignoring files/.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example 是唯一入库的模板，其余本地变量一律忽略)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 数据快照与本地运行产物（不进版本库；磁盘保留，恢复基线见 data/backups/README.md）
/.tmp/
/.playwright-mcp/
/data/audit/
/data/ingest/
/data/migrations/
/data/backups/**/*.dump
/data/xhs/
/data/baidu/
/data/sogou/
/data/zhihu/

# 迁移脚本生成的回滚 SQL（本地产物）
/rollback.sql
/scripts/rollback.sql

# AI agent 工具链配置（Claude Code / Codex / Trellis / pi 等，不进版本库）
/.agents/
/.claude/
/.codex/
/.pi/
/.trellis/
/.github/skills/
/AGENTS.md
/CLAUDE.md

# 临时产物（采集期 PDF/图片等，磁盘保留）
/tmp/
