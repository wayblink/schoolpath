<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Cache-Control" content="no-cache">
<title>上海学区地图 — 学校 → 居委 → 小区</title>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang SC','Microsoft YaHei',sans-serif;background:#1a1a2e;height:100vh;overflow:hidden}
#map{width:100%;height:100%}
.panel{position:absolute;top:12px;right:16px;background:rgba(255,255,255,.95);border-radius:12px;padding:14px 18px;box-shadow:0 4px 20px rgba(0,0,0,.15);font-size:12px;max-width:340px;width:320px;z-index:100;line-height:1.6;max-height:calc(100vh - 24px);display:flex;flex-direction:column}
.panel h2{font-size:15px;color:#1a1a2e;margin-bottom:2px;flex-shrink:0;display:flex;flex-wrap:wrap;align-items:center;gap:4px 6px}
.panel h2 .tier-badge{font-size:9px;padding:1px 5px;border-radius:3px;font-weight:700}
.panel h2 .tier-1{background:#dcfce7;color:#166534}
.panel h2 .tier-2{background:#fef3c7;color:#92400e}
.panel h2 .tier-3{background:#fee2e2;color:#991b1b}
.panel h2 .arrow{color:#94a3b8;font-size:12px}
.panel h2 .ms-name{color:#1e40af}
.panel h2 .hint{font-size:10px;color:#94a3b8;font-weight:400}
.panel .sub{color:#888;font-size:11px;margin-bottom:6px;flex-shrink:0}
.panel .sub strong{color:#1a1a2e}
.panel .sub .sub-tier{padding:0 4px;font-size:10px}
.panel select{width:100%;padding:6px 10px;border:1px solid #ddd;border-radius:6px;font-size:12px;margin-bottom:6px;background:#fff}
.panel .count{color:#666;font-size:11px;margin-bottom:4px;flex-shrink:0}
.panel .list-scroll{flex:1;overflow-y:auto;font-size:11px;min-height:0}
.back-btn{position:absolute;top:12px;left:16px;background:rgba(255,255,255,.95);border-radius:10px;padding:8px 14px;box-shadow:0 4px 20px rgba(0,0,0,.15);font-size:11px;z-index:100;cursor:pointer;border:none;color:#3b82f6;text-decoration:none;display:inline-block}
.back-btn:hover{background:#eff6ff}
.legend{position:absolute;top:50px;left:16px;background:rgba(255,255,255,.95);border-radius:10px;padding:8px 14px;box-shadow:0 4px 20px rgba(0,0,0,.15);font-size:11px;line-height:1.6;z-index:100;white-space:nowrap}
.comm-item{padding:4px 6px;margin:2px 0;border-radius:4px;border-left:3px solid transparent;display:flex;align-items:center;gap:6px;font-size:12px;transition:background .1s;cursor:pointer}
.comm-item:hover{background:#f0f9ff;border-left-color:#3b82f6}
.comm-item .cname{font-weight:500;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.comm-item .jtag{font-size:10px;color:#64748b;white-space:nowrap}
.comm-item .lj-btn{padding:3px 8px;background:#3b82f6;color:#fff;border-radius:4px;font-size:10px;text-decoration:none;white-space:nowrap;border:none;cursor:pointer}
.comm-item .lj-btn:hover{background:#2563eb}
.comm-item .hide-btn{padding:3px 7px;background:none;border:1px solid #e2e8f0;border-radius:4px;font-size:10px;cursor:pointer;color:#94a3b8;white-space:nowrap}
.comm-item .hide-btn:hover{border-color:#ef4444;color:#ef4444}
.comm-item .unhide-btn{display:none;padding:3px 7px;background:none;border:1px solid #16a34a;border-radius:4px;font-size:10px;cursor:pointer;color:#16a34a;white-space:nowrap}
.comm-item.hidden-state{opacity:.35;background:#fef2f2;border-left-color:#ef4444}
.comm-item.hidden-state .cname{text-decoration:line-through}
.comm-item.hidden-state .unhide-btn{display:inline}
.comm-item.hidden-state .hide-btn{border-color:#ef4444;color:#ef4444}
.comm-item.hidden-row{display:none}
.juwei-tags{margin-bottom:6px;display:flex;flex-wrap:wrap;gap:4px;flex-shrink:0}
.juwei-tag{font-size:10px;padding:2px 7px;background:#ecfdf5;color:#065f46;border-radius:4px;cursor:pointer;border:1px solid transparent;transition:all .15s;white-space:nowrap}
.juwei-tag:hover{background:#d1fae5;border-color:#10b981}
.juwei-tag.active{background:#10b981;color:#fff;border-color:#059669}
.juwei-tag.tag-no-comm{background:#f3f4f6;color:#9ca3af;border:1px dashed #d1d5db}
.juwei-tag.tag-no-comm:hover{background:#e5e7eb;color:#6b7280;border-color:#9ca3af}
.juwei-tag.tag-no-comm.active{background:#9ca3af;color:#fff;border-color:#6b7280}
#tooltip{display:none;position:absolute;background:rgba(0,0,0,.82);color:#fff;padding:6px 10px;border-radius:6px;font-size:12px;pointer-events:none;z-index:200;white-space:nowrap;line-height:1.4}
.drag-handle{display:none}
.loading-bar{position:absolute;top:0;left:0;height:3px;background:#3b82f6;z-index:300;transition:width .3s,opacity .5s;width:0%}
.tier-badge{display:inline-block;font-size:10px;padding:1px 5px;border-radius:3px;font-weight:700}
.tier-1{background:#dcfce7;color:#166534}
.tier-2{background:#fef3c7;color:#92400e}
.tier-3{background:#fee2e2;color:#991b1b}
.detail-bar{display:none;border-top:1px solid #e2e8f0;padding:10px 0;margin-top:6px;flex-shrink:0;font-size:12px;line-height:1.7}
.detail-bar.show{display:block}
.detail-bar h3{font-size:14px;margin-bottom:4px}
.detail-bar .d-row{display:flex;gap:12px;flex-wrap:wrap;margin:2px 0}
.detail-bar .d-label{color:#94a3b8;font-size:10px}
.detail-bar .d-actions{margin-top:8px;display:flex;gap:8px;align-items:center}
.detail-bar .fav-btn,.detail-bar .fav-btn2{padding:4px 10px;border:1px solid #f59e0b;border-radius:5px;background:#fff;color:#f59e0b;cursor:pointer;font-size:11px}
.detail-bar .fav-btn.active,.detail-bar .fav-btn2.active{background:#f59e0b;color:#fff}
.detail-bar .fav-btn2{font-size:11px;padding:3px 8px}
.comm-item .fav-star{font-size:14px;cursor:pointer;color:#d1d5db;padding:0 2px;line-height:1;user-select:none;flex-shrink:0}
.comm-item .fav-star.active{color:#f59e0b}
.comm-item .fav-btn-mobile{display:none}
.tab-bar{display:flex;gap:0;margin-bottom:6px;flex-shrink:0;border-bottom:2px solid #e2e8f0}
.tab-bar button{flex:1;padding:5px 0;border:none;background:none;cursor:pointer;font-size:11px;color:#94a3b8;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s}
.tab-bar button.active{color:#16a34a;border-bottom-color:#16a34a;font-weight:600}
.fav-count{font-size:10px;background:#f59e0b;color:#fff;border-radius:8px;padding:0 5px;margin-left:3px}

/* ---- Search ---- */
.search-wrap{position:absolute;top:12px;left:130px;right:350px;z-index:170}
.search-wrap .s-input{width:100%;padding:9px 12px 9px 34px;border:none;border-radius:10px;font-size:13px;background:rgba(255,255,255,.95);box-shadow:0 4px 16px rgba(0,0,0,.12);outline:none;transition:box-shadow .2s}
.search-wrap .s-input:focus{box-shadow:0 4px 16px rgba(59,130,246,.25)}
.search-wrap .s-icon{position:absolute;left:11px;top:50%;transform:translateY(-50%);font-size:14px;color:#94a3b8;pointer-events:none}
.search-drop{display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:rgba(255,255,255,.98);border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.15);max-height:380px;overflow-y:auto;font-size:12px}
.search-drop.show{display:block}
.search-drop .sg-label{padding:8px 14px 3px;font-size:10px;color:#94a3b8;font-weight:600;letter-spacing:.3px}
.search-drop .s-item{padding:7px 14px;cursor:pointer;display:flex;align-items:center;gap:7px;transition:background .1s;border-left:3px solid transparent}
.search-drop .s-item:hover,.search-drop .s-item.hl{background:#f0f9ff;border-left-color:#3b82f6}
.search-drop .s-item .si-type{font-size:14px;flex-shrink:0;width:22px;text-align:center}
.search-drop .s-item .si-name{font-weight:500;color:#1a1a2e;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.search-drop .s-item .si-ctx{font-size:10px;color:#94a3b8;margin-left:auto;flex-shrink:0;white-space:nowrap}
.search-drop .s-empty{padding:20px;text-align:center;color:#94a3b8;font-size:12px}

/* ---- Mobile responsive ---- */
@media(max-width:768px){
  body{--panel-height:40vh}
  #map{height:100%}
  .panel{
    position:fixed;top:auto;bottom:0;left:0;right:0;
    max-width:none;width:100%;max-height:var(--panel-height);
    border-radius:16px 16px 0 0;padding:2px 14px 14px;
    transition:max-height .3s ease,transform .3s ease;
    box-shadow:0 -4px 20px rgba(0,0,0,.18);
    z-index:150
  }
  .panel.expanded{max-height:85vh}
  .panel .drag-handle{display:flex;flex-direction:column;align-items:center;padding:6px 0 2px;cursor:pointer}
  .panel .drag-handle::before{content:'';display:block;width:36px;height:3px;background:#cbd5e1;border-radius:3px}
  .panel .drag-handle .hint-text{font-size:9px;color:#94a3b8;margin-top:2px}
  .panel h2{font-size:13px;margin-bottom:2px}
  .panel .sub{font-size:10px;margin-bottom:2px}
  .panel select{padding:12px 12px;font-size:16px;min-height:52px;margin-bottom:5px;line-height:1.4}
  .panel .count{font-size:10px}
  .panel .list-scroll{font-size:10px;max-height:130px;overflow-y:auto;flex:none}
  .tab-bar{display:none!important}
  .panel .comm-item{font-size:11px;padding:6px 5px}
  .panel .juwei-tags{gap:3px;margin-bottom:4px}
  .panel .juwei-tag{font-size:9px;padding:2px 5px}
  .detail-bar{display:none!important}
  .comm-item .fav-star{display:none}
  .comm-item .fav-btn-mobile{display:inline-block;padding:3px 7px;background:none;border:1px solid #f59e0b;border-radius:4px;font-size:10px;cursor:pointer;color:#f59e0b;white-space:nowrap;min-height:32px}
  .comm-item .fav-btn-mobile.active{background:#f59e0b;color:#fff}
  .back-btn{top:8px;left:8px;padding:10px 12px;font-size:12px;border-radius:8px;z-index:160;min-height:42px;display:inline-flex;align-items:center}
  .legend{top:50px;left:8px;font-size:10px;padding:6px 8px;border-radius:8px;line-height:1.4;z-index:160;max-width:calc(100vw - 120px)}

  .detail-bar h3{font-size:12px}
  .detail-bar .d-row{font-size:11px}
  .comm-item .lj-btn,.comm-item .hide-btn,.comm-item .unhide-btn{padding:4px 8px;font-size:10px;min-height:32px}
  .comm-item .fav-star{font-size:16px}
}

@media(max-width:480px){
  .panel{--panel-height:33vh;padding:2px 10px 10px}
  .panel h2{font-size:12px}
  .panel select{font-size:16px;min-height:52px;padding:12px 10px;line-height:1.4}
  .panel .list-scroll{max-height:120px}
  .panel .comm-item{font-size:12px}
  .panel .tab-bar button{font-size:9px;padding:5px 0}
  .back-btn{padding:8px 10px;font-size:10px;min-height:40px;display:inline-flex;align-items:center}
  .legend{font-size:9px;padding:4px 6px;line-height:1.4;max-width:calc(100vw - 100px)}
}

@media(max-width:768px){
	.search-wrap{top:8px;left:108px;right:8px;transform:none;width:auto;max-width:none}
	.search-wrap .s-input{padding:10px 10px 10px 32px;font-size:14px}
	.search-drop{max-height:260px}
}

</style>
</head>
<body>
<div id="map"></div>
<div class="loading-bar" id="loadingBar"></div>
<div id="tooltip"></div>

<div class="search-wrap" id="searchWrap">
  <span class="s-icon">🔍</span>
  <input class="s-input" id="searchInput" placeholder="搜索学校、街道、居委、小区…" autocomplete="off" oninput="onSearchInput()" onfocus="onSearchFocus()" onkeydown="onSearchKey(event)">
  <div class="search-drop" id="searchDrop"></div>
</div>

<a class="back-btn" id="backBtn" href="上海学区信息.html">← 返回学区信息</a>

<div class="panel" id="panel">
  <div class="drag-handle" id="dragHandle" onclick="togglePanelExpand()"><span class="hint-text">上滑展开</span></div>
  <h2>🏫 上海学区地图</h2>
  <div class="sub" id="panelSub">加载中...</div>
  <select id="districtSel" onchange="onDistrictChange()"><option value="">选择区县...</option></select>
  <select id="schoolSel" onchange="onSchoolChange()" style="display:none"><option value="">选择学校...</option></select>
  <select id="middleSel" onchange="onMiddleChange()" style="display:none"><option value="">选择初中...</option></select>
  <div class="count" id="infoCount"></div>
  <div class="juwei-tags" id="juweiTags"></div>
  <div class="tab-bar" id="tabBar" style="display:none">
    <button class="active" onclick="switchTab('list')">小区列表</button>
    <button onclick="switchTab('fav')">收藏夹<span class="fav-count" id="favCount"></span></button>
  </div>
  <div class="list-scroll" id="commList"></div>
  <div class="detail-bar" id="detailBar"></div>
</div>

<div class="legend" id="legend">
  <span style="color:#10b981;">■</span> 对口居委 &nbsp;
  <span style="color:#f97316;">●</span> 对口门牌 &nbsp;
  <span style="color:#f59e0b;border:2px solid #f59e0b;display:inline-block;width:12px;height:12px"></span> 选中居委 &nbsp;
  <span style="border-bottom:3px solid #ef4444;">━</span> 外环
  <span style="border-bottom:3px solid #10b981;">━</span> 中环
  <span style="border-bottom:3px solid #3b82f6;">━</span> 内环
</div>

<script src="https://webapi.amap.com/maps?v=2.0&key=2a8d35f0c2d3674fea28f1050b7c8be2"></script>
<script>

// ---- Mobile helpers ----
function isMobile() { return window.innerWidth <= 768; }

function autoExpandPanel() {
  if (isMobile()) {
    document.getElementById('panel').classList.add('expanded');
  }
}

// ---- Mobile panel expand/collapse ----
function togglePanelExpand() {
  var p = document.getElementById('panel');
  if (p.classList.contains('expanded')) {
    p.classList.remove('expanded');
  } else {
    p.classList.add('expanded');
  }
}

// Touch swipe on panel header area (mobile): 下滑隐藏、上滑打开
(function(){
  var touchY = 0;
  // Attach to drag handle + panel header (h2, sub, dropdowns area)
  var targets = document.querySelectorAll('#dragHandle, .panel h2, .panel .sub');
  targets.forEach(function(el) {
    el.addEventListener('touchstart', function(e) { touchY = e.touches[0].clientY; }, {passive:true});
    el.addEventListener('touchend', function(e) {
      var dy = (e.changedTouches[0] || {}).clientY - touchY;
      var panel = document.getElementById('panel');
      if (dy > 30) { panel.classList.remove('expanded'); }       // 下滑 = 隐藏面板
      else if (dy < -30) { panel.classList.add('expanded'); }    // 上滑 = 打开面板
    }, {passive:true});
  });
})();

// Open Lianjia link — web page with community search; lianjia site has its own app-open button
function openLj(url) {
  if (!url || url === '#') return;
  window.open(url, '_blank');
}

	var map = new AMap.Map('map', {
  center: [121.47, 31.23],
  zoom: 11,
  // Use default map style (includes road labels, most stable for v2.0)
});

function panelWidth() {
  var panel = document.getElementById('panel');
  return panel ? panel.offsetWidth : 0;
}

function panelHeight() {
  var panel = document.getElementById('panel');
  return panel ? panel.offsetHeight : 0;
}

// Mobile: offset center upward so the target isn't hidden behind the bottom panel.
// Desktop: screen is large enough, no offset needed.
function centerOn(lng, lat, zoom) {
  map.setZoomAndCenter(zoom, [lng, lat]);
  if (isMobile()) {
    var ph = panelHeight();
    if (ph > 0) {
      // Convert panel-height pixel offset to latitude degrees using current bounds
      var bounds = map.getBounds();
      var ne = bounds.getNorthEast();
      var sw = bounds.getSouthWest();
      var ch = map.getContainer().offsetHeight;
      var latPerPx = (ne.lat - sw.lat) / ch;
      map.setCenter([lng, lat - latPerPx * (ph / 2)]);
    }
  }
}

// Mobile: add top padding to shift content above the bottom panel (~1/3).
// Desktop: even padding on all sides.
function panelRightPadding(base) {
  var b = base || 40;
  if (isMobile()) {
    var bottom = Math.round(panelHeight() * 0.5) + b;
    return [b, b, bottom, b];
  }
  return [b, b, b, b];
}

// ---- Geocoding via 高德 REST API ----
var AMAP_KEY = '2a8d35f0c2d3674fea28f1050b7c8be2';
var juweiPolyIdx = {};  // district|juweiShort → [[ring], [ring], ...]

function buildJuweiPolyIndex() {
  juweiPolyIdx = {};
  juweiFeatures.forEach(function(f) {
    var dist = f.properties['区'];
    var short = f.properties.name.replace(/居委会$/, '').replace(/居委$/, '');
    var key = dist + '|' + short;
    if (!juweiPolyIdx[key]) juweiPolyIdx[key] = [];
    var rings = getPolygonRings(f);
    for (var i = 0; i < rings.length; i++) {
      juweiPolyIdx[key].push(rings[i]);
    }
  });
}

function getPolygonRings(feature) {
  var geom = feature.geometry;
  var rings = [];
  if (geom.type === 'Polygon') {
    rings.push(geom.coordinates[0].map(function(c) { return [c[0], c[1]]; }));
  } else if (geom.type === 'MultiPolygon') {
    geom.coordinates.forEach(function(part) {
      rings.push(part[0].map(function(c) { return [c[0], c[1]]; }));
    });
  }
  return rings;
}

function pointInRing(point, ring) {
  var x = point[0], y = point[1];
  var inside = false;
  for (var i = 0, j = ring.length - 1; i < ring.length; j = i++) {
    var xi = ring[i][0], yi = ring[i][1];
    var xj = ring[j][0], yj = ring[j][1];
    if ((yi > y) !== (yj > y) && x < (xj - xi) * (y - yi) / (yj - yi) + xi) {
      inside = !inside;
    }
  }
  return inside;
}

function pointInJuwei(point, district, juweiShort) {
  var key = district + '|' + juweiShort;
  var rings = juweiPolyIdx[key];
  if (!rings) return false;
  for (var i = 0; i < rings.length; i++) {
    if (pointInRing(point, rings[i])) return true;
  }
  return false;
}

function commCacheKey(district, name) {
  return district + '|' + name;
}

function geocodeOne(name, district, juweiShort) {
  var ck = commCacheKey(district, name);
  if (commCoords[ck] !== undefined) return;

  var url = 'https://restapi.amap.com/v3/place/text?key=' + AMAP_KEY +
    '&keywords=' + encodeURIComponent(district + ' ' + name) +
    '&city=上海&citylimit=true&offset=5';

  fetch(url)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.status === '1' && data.pois && data.pois.length > 0) {
        var best = null;
        for (var i = 0; i < data.pois.length; i++) {
          var parts = data.pois[i].location.split(',');
          var point = [parseFloat(parts[0]), parseFloat(parts[1])];
          // Prefer a result inside the parent 居委 polygon
          if (juweiShort && pointInJuwei(point, district, juweiShort)) {
            commCoords[ck] = point;
            return;
          }
          if (!best) best = point;
        }
        // Accept first result even if outside polygon (OSM boundaries don't perfectly match 高德 POI)
        if (best) commCoords[ck] = best;
      } else {
        // No API results — cache null to prevent retries
        commCoords[ck] = null;
      }
    })
    .catch(function() { /* ignore */ });
}

function batchGeocode(communities, district) {
  communities.forEach(function(c, i) {
    setTimeout(function() {
      geocodeOne(c.n, district, c.j);
    }, i * 250);
  });
}

// ---- State ----
var schoolData = null;
var juweiFeatures = [];
var districtConfig = {};  // enabled districts from district_config.json
var dataReady = 0;
var selectedSchool = null;
var currentMode = null;     // 'school' | 'middle'
var middleIndexCache = {};  // district → [{n, r, feeders:[], t}]
var schoolJuweiPolys = [];
var selectedJuwei = null; // Currently highlighted 居委 name
var hoverJuwei = null;   // Hovered 居委 name (from community hover)
var showHidden = false;
var HIDDEN = {};
var commCoords = {};     // district|communityName → [lng, lat] validated coords
var middleTierData = null; // {cleaned: {name→tier}, by_district: {district→[{n,r}]}}
var juweiSchoolIdx = {}; // district|schoolName → [jwGeoKeys] (居委制学区→居委列表)
var jwNameToGeoKey = {}; // district|schoolJwName → district|geoJwKey (maps school juwei names to GeoJSON keys)
var schoolStreetMap = {}; // district|schoolName → [街道 names] (for 地段制 schools without juwei matches)
var schoolMarkers = [];   // AMap markers for school positions
var showingSchoolMarkers = true;
try { HIDDEN = JSON.parse(localStorage.getItem('scm-hidden') || '{}'); } catch(e) { HIDDEN = {}; }

var FAVORITES = {};
try { FAVORITES = JSON.parse(localStorage.getItem('scm-fav') || '{}'); } catch(e) { FAVORITES = {}; }

var currentTab = 'list';   // 'list' or 'fav'
var selectedComm = null;   // currently selected community data
var selectedAddr = null;   // currently selected g.p address

function saveHidden() {
  try { localStorage.setItem('scm-hidden', JSON.stringify(HIDDEN)); } catch(e) {}
}

function saveFavorites() {
  try { localStorage.setItem('scm-fav', JSON.stringify(FAVORITES)); } catch(e) {}
}

function buildShHash(school, district, baseUrl) {
  var areas = school ? (school.j || []) : [];
  var ctx = {
    school: school ? school.n : '',
    middle: school ? school.m : '',
    district: district || '',
    street: school ? school.t : '',
    areas: areas,
    exclude: [],
    baseUrl: baseUrl || ''
  };
  return '#__sh__' + encodeURIComponent(JSON.stringify(ctx));
}

function buildLianjiaAddrUrl(addr) {
  return 'https://sh.lianjia.com/ershoufang/rs' + encodeURIComponent(addr) + '/';
}

function getSchoolByName(district, schoolName) {
  if (!schoolData || !district) return null;
  var schools = schoolData.districts[district] || [];
  for (var i = 0; i < schools.length; i++) {
    if (schools[i].n === schoolName) return schools[i];
  }
  return null;
}

function toggleFavorite(district, schoolName, commName, juweiShort, year, type, price, ljUrl) {
  var key = district + '|' + commName;
  if (FAVORITES[key]) {
    delete FAVORITES[key];
  } else {
    FAVORITES[key] = {
      d: district, s: schoolName, n: commName, j: juweiShort,
      y: year, t: type, p: price, u: ljUrl
    };
  }
  saveFavorites();
  renderCommunityList(selectedSchool);
  if (selectedComm && selectedComm.n === commName && !isMobile()) showCommDetail(commName);
}

function toggleFavoriteAddr(district, schoolName, addr) {
  var key = district + '|' + addr;
  if (FAVORITES[key]) {
    delete FAVORITES[key];
  } else {
    FAVORITES[key] = {
      d: district, s: schoolName, n: addr, j: '', y: '', t: '', p: '', u: buildLianjiaAddrUrl(addr)
    };
  }
  saveFavorites();
  renderCommunityList(selectedSchool);
  // Re-show detail if we were viewing this address
  if (selectedAddr === addr && !isMobile()) {
    var g = selectedSchool.g || {};
    var pts = g.p || [];
    for (var i = 0; i < pts.length; i++) {
      if (pts[i].a === addr) { showAddrDetail(addr, district, pts[i].lng, pts[i].lat); break; }
    }
  }
}

function isFavorite(district, commName) {
  return !!FAVORITES[district + '|' + commName];
}

function switchTab(tab) {
  currentTab = tab;
  var btns = document.querySelectorAll('.tab-bar button');
  btns[0].classList.toggle('active', tab === 'list');
  btns[1].classList.toggle('active', tab === 'fav');
  if (tab === 'fav') {
    renderFavoriteList();
  } else {
    renderCommunityList(selectedSchool);
  }
}

function showCommDetail(commName) {
  if (!selectedSchool) return;
  var comm = null;
  selectedSchool.c.forEach(function(c) {
    if (c.n === commName) comm = c;
  });

  // Check g.p addresses if not found in c
  if (!comm) {
    var g = selectedSchool.g || {};
    var pts = g.p || [];
    for (var i = 0; i < pts.length; i++) {
      if (pts[i].a === commName) {
        var dist = document.getElementById('districtSel').value;
        showAddrDetail(commName, dist, pts[i].lng, pts[i].lat);
        return;
      }
    }
    return;
  }

  selectedComm = comm;
  var bar = document.getElementById('detailBar');
  var dist = document.getElementById('districtSel').value;
  var fav = isFavorite(dist, comm.n);
  var priceDisplay = comm.p || '';
  if (typeof priceDisplay === 'object') {
    priceDisplay = (priceDisplay.低||'') + '-' + (priceDisplay.高||'');
  }

  var html = '<h3>' + escHtml(comm.n) + '</h3>' +
    '<div class="d-row"><span class="d-label">居委</span> ' + escHtml(comm.j) + '</div>' +
    (comm.addr ? '<div class="d-row"><span class="d-label">地址</span> ' + escHtml(comm.addr) + '</div>' : '') +
    '<div class="d-row">' +
    (comm.y ? '<span><span class="d-label">建成</span> ' + escHtml(String(comm.y)) + '年</span>' : '') +
    (comm.t ? '<span><span class="d-label">类型</span> ' + escHtml(String(comm.t)) + '</span>' : '') +
    (priceDisplay ? '<span><span class="d-label">参考价</span> ' + escHtml(String(priceDisplay)) + '元/㎡</span>' : '') +
    '</div>' +
    '<div class="d-actions">' +
    '<button class="fav-btn2' + (fav ? ' active' : '') + '" onclick="toggleFavorite(\'' +
    escAttr(dist) + '\',\'' + escAttr(selectedSchool.n) + '\',\'' + escAttr(comm.n) + '\',\'' +
    escAttr(comm.j) + '\',\'' + escAttr(String(comm.y||'')) + '\',\'' + escAttr(String(comm.t||'')) + '\',\'' +
    escAttr(String(comm.p||'')) + '\',\'' + escAttr(comm.u||'') + '\')">' +
    (fav ? '★ 已收藏' : '☆ 收藏小区') + '</button>' +
    '<a class="lj-btn" href="' + (comm.u || '#') + buildShHash(selectedSchool, dist, comm.u || '') + '" onclick="openLj(this.href);return false" style="padding:4px 12px;font-size:11px">链家 →</a>' +
    '<button onclick="closeDetail()" style="background:none;border:1px solid #e2e8f0;border-radius:5px;padding:4px 10px;cursor:pointer;font-size:11px;color:#94a3b8">关闭</button>' +
    '</div>';

  bar.innerHTML = html;
  bar.classList.add('show');
  bar.scrollIntoView({behavior:'smooth',block:'nearest'});
}

function closeDetail() {
  document.getElementById('detailBar').classList.remove('show');
  selectedComm = null;
  selectedAddr = null;
}

function renderFavoriteList() {
  var favs = Object.values(FAVORITES);
  var html = '';
  if (favs.length === 0) {
    html = '<div style="color:#999;text-align:center;padding:20px">暂无收藏</div>';
  } else {
    favs.sort(function(a, b) { return (a.d + a.n).localeCompare(b.d + b.n, 'zh'); });
    favs.forEach(function(f) {
      html += '<div class="comm-item"' +
        ' onmouseover="commHover(\'' + escAttr(f.j) + '\',\'' + escAttr(f.n) + '\',\'' + escAttr(f.d) + '\')"' +
        ' onmouseout="commUnhover(\'' + escAttr(f.j) + '\')"' +
        ' onclick="commClick(\'' + escAttr(f.j) + '\',\'' + escAttr(f.n) + '\',\'' + escAttr(f.d) + '\')">' +
        '<span class="fav-star active" onclick="event.stopPropagation();toggleFavorite(\'' +
        escAttr(f.d) + '\',\'' + escAttr(f.s) + '\',\'' + escAttr(f.n) + '\',\'' +
        escAttr(f.j) + '\',\'' + escAttr(String(f.y||'')) + '\',\'' + escAttr(String(f.t||'')) + '\',\'' +
        escAttr(String(f.p||'')) + '\',\'' + escAttr(f.u||'') + '\')">★</span>' +
        '<span class="cname" title="' + escAttr(f.n + ' · ' + f.d + ' · ' + f.j) + '">' + escHtml(f.n) + '</span>' +
        '<span class="jtag">' + escHtml(f.d + ' · ' + f.j) + '</span>' +
        '<a class="lj-btn" href="' + (f.u||'#') + buildShHash(getSchoolByName(f.d, f.s), f.d, f.u||'') + '" onclick="openLj(this.href);event.stopPropagation();return false">链家→</a>' +
        '</div>';
    });
  }
  document.getElementById('commList').innerHTML = html;
  document.getElementById('detailBar').classList.remove('show');
  selectedComm = null;
  updateFavCount();
}

function updateFavCount() {
  var count = Object.keys(FAVORITES).length;
  var el = document.getElementById('favCount');
  if (el) el.textContent = count > 0 ? count : '';
  if (el) el.style.display = count > 0 ? 'inline' : 'none';
}

