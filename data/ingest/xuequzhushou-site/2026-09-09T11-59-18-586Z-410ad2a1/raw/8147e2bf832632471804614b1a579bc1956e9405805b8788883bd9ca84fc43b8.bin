市北初级中学北校":2,"市西":1,"市西初级中学":1,"彭浦":2,"彭浦初级中学":2,"彭浦第三":3,"彭浦第三中学":3,"彭浦第四":3,"彭浦第四中学":3,"新中":2,"新中初级中学":2,"时代":3,"时代中学":3,"朝阳":3,"朝阳中学":3,"民立":3,"民立中学":3,"育才":2,"育才初级中学":2,"苏河湾":2,"苏河湾实验中学":2,"闸北第八":3,"闸北第八中学":3,"青云":2,"青云中学":2,"静安区":3,"静安区实验中学":3,"静教院附校":1,"静教院附校(初中部)":1,"风华":2,"风华初级中学":2},"浦东新区":{"建平西校":1,"建平西校(华城校区)":1,"建平西校(大唐校区)":1,"建平实验":1,"建平实验中学":1,"建平实验中学(枣庄校区)":1,"进才北校":1,"进才实验":1,"进才实验中学":1,"实验东校":1,"上海市实验学校东校":1,"洋泾菊园":1,"洋泾菊园实验学校":1,"建平南校":2,"建平中学南校":2,"浦东外国语":1,"浦东外国语学校":1,"张江集团":1,"张江集团学校":1,"致远":2,"致远中学":2,"浦东模范":2,"浦东模范中学":2,"建平香梅":2,"建平香梅中学":2,"罗山":2,"罗山中学":2,"清流":2,"清流中学":2,"上南北校":2,"上南中学北校":2,"上南南校":2,"上南中学南校":2,"洋泾东校":2,"洋泾中学东校":2,"洪山":2,"洪山中学":2,"三林北校":2,"三林中学北校":2,"进才南校":2,"进才中学南校":2,"北蔡":2,"北蔡中学":2,"杨思":2,"杨思中学":2,"沪东":2,"沪东中学":2,"浦兴":2,"浦兴中学":2,"建平地杰":1,"建平地杰中学":1,"东昌南校":2},"闵行区":{"上实西校":1,"莘松":1,"莘松中学":1,"莘松中学(莘沥校区)":1,"莘松中学(春申校区)":1,"交大二附中":1,"闵华二":1,"闵华二初级中学":1,"七宝二中":2,"莘光":2,"莘光学校":2,"莘城":2,"莘城学校":2,"七宝三中":2,"七宝文来":2,"七宝文来学校":2,"晶城":2,"晶城中学":2,"颛桥":2,"颛桥中学":2,"罗阳":2,"罗阳中学":2,"浦航实中":2,"鹤北":2,"鹤北中学":2}};

function getMiddleTierRange(district, mString) {
  if (!mString || !MS_TIER[district]) return null;
  var parts = mString.split('/');
  var tiers = {};
  var lookup = MS_TIER[district];
  parts.forEach(function(raw) {
    var name = raw.replace(/\([^)]*\)/g, '').trim();
    if (!name || name.length < 2) return;
    var tier = lookup[name];
    if (!tier) {
      var short = name.replace(/中学$/, '').replace(/学校$/, '').trim();
      tier = lookup[short];
    }
    if (!tier) {
      Object.keys(lookup).forEach(function(k) {
        if (msMatch(k, name)) tier = lookup[k];
      });
    }
    if (tier) tiers[tier] = true;
  });
  var arr = Object.keys(tiers).map(Number).sort(function(a, b) { return a - b; });
  if (arr.length === 0) return null;
  if (arr.length === 1) return String(arr[0]);
  return arr[0] + '-' + arr[arr.length - 1];
}

function tierBadge(tierRange) {
  if (!tierRange) return '';
  var t = parseInt(tierRange);
  if (!isNaN(t)) return '<span class="tier-badge tier-' + t + '">T' + tierRange + '</span>';
  return '<span class="tier-badge tier-' + tierRange.split('-')[0] + '">T' + tierRange + '</span>';
}

// ---- Middle school name normalization ----
function cleanSchoolName(s) {
  if (!s) return '';
  return s.replace(/\([^)]*\)/g, '').replace(/（[^）]*）/g, '')
    .replace(/中学$/, '')
    .replace(/学校$|校区$|分校$/, '').trim();
}

function msMatch(a, b) {
  if (!a || !b) return false;
  var ca = cleanSchoolName(a), cb = cleanSchoolName(b);
  if (ca === cb) return true;
  // Prefix-only match: one must be prefix of the other, with keyword consistency
  function checkPrefix(shorter, longer) {
    if (longer.indexOf(shorter) !== 0) return false;
    if (shorter === '') return false;
    var keys = ['实验', '初级', '附属', '北校', '南校', '西', '东'];
    for (var i = 0; i < keys.length; i++) {
      var k = keys[i];
      if ((shorter.indexOf(k) >= 0) !== (longer.indexOf(k) >= 0)) return false;
    }
    return true;
  }
  if (checkPrefix(ca, cb) || checkPrefix(cb, ca)) return true;
  // Try abbreviation: 初级 → 初
  function abbrev(s) { return s.replace(/初级/g, '初'); }
  var aa = abbrev(ca), ab = abbrev(cb);
  if (aa === ab) return true;
  if (checkPrefix(aa, ab) || checkPrefix(ab, aa)) return true;
  return false;
}

// Look up the actual tier of a middle school by matching against district 初中 data
function getMiddleTier(district, name) {
  if (!middleTierData || !name || !district) return null;
  var cleaned = cleanSchoolName(name);
  if (!cleaned) return null;
  // Direct cleaned lookup
  var tier = middleTierData.cleaned[cleaned];
  if (tier !== undefined) return tier;
  // Fallback: msMatch against district's middle school list
  var msList = (middleTierData.by_district[district] || []);
  for (var i = 0; i < msList.length; i++) {
    var msCleaned = cleanSchoolName(msList[i].n);
    if (msCleaned === cleaned || msMatch(cleaned, msCleaned)) return msList[i].r;
  }
  return null;
}

// ---- Middle school index ----
function buildMiddleIndex(district) {
  if (middleIndexCache[district]) return middleIndexCache[district];
  var schools = schoolData.districts[district] || [];
  var index = {};
  schools.forEach(function(s) {
    var mNames = (s.m || '').split('/');
	    if (s.m === '户籍对口(按地段)') return; // skip placeholder entries
    mNames.forEach(function(raw) {
      var name = raw.replace(/\([^)]*\)/g, '').trim();
      if (!name || name.length < 2) return;
      // Find existing entry that matches this name
      var key = name;
      Object.keys(index).forEach(function(k) {
        if (msMatch(k, name)) { key = k; }
      });
      if (!index[key]) index[key] = { r: s.mr || 0, feeders: [], streets: {}, feederTiers: [] };
      if (index[key].feeders.indexOf(s.n) < 0) {
        index[key].feeders.push(s.n);
        index[key].feederTiers.push(s.r);
      }
      if (s.t) index[key].streets[s.t] = true;
    });
  });
  var result = [];
  Object.keys(index).forEach(function(name) {
    var e = index[name];
    result.push({ n: name, r: e.r, feeders: e.feeders, feederTiers: e.feederTiers, t: Object.keys(e.streets).join('/') });
  });
  result.sort(function(a, b) { return a.r - b.r || a.n.localeCompare(b.n, 'zh'); });
  middleIndexCache[district] = result;
  return result;
}

function buildMergedSchool(district, middleName) {
  var schools = schoolData.districts[district] || [];

  function findFeeders(msName) {
    var result = [];
    schools.forEach(function(s) {
      var mNames = (s.m || '').split('/');
	    if (s.m === '户籍对口(按地段)') return; // skip placeholder entries
      for (var i = 0; i < mNames.length; i++) {
        var mn = mNames[i].replace(/\([^)]*\)/g, '').trim();
        if (mn === msName || msMatch(mn, msName)) { result.push(s); break; }
      }
    });
    return result;
  }

  var feeder = findFeeders(middleName);

  // If no exact/fuzzy match, try matching against the middle index entries
  if (feeder.length === 0) {
    var midList = buildMiddleIndex(district);
    for (var k = 0; k < midList.length; k++) {
      if (msMatch(midList[k].n, middleName)) {
        feeder = findFeeders(midList[k].n);
        middleName = midList[k].n; // use the canonical abbreviated name
        break;
      }
    }
  }

  if (feeder.length === 0) return null;
  var jwSet = {}, commMap = {};
  var streets = [];
  feeder.forEach(function(s) {
    (s.j || []).forEach(function(j) { jwSet[j] = true; });
    (s.c || []).forEach(function(c) { if (!commMap[c.n]) commMap[c.n] = c; });
    if (s.t && streets.indexOf(s.t) < 0) streets.push(s.t);
  });
  // Compute position from feeder schools' own coordinates as fallback
  var cx = 0, cy = 0, cn = 0;
  feeder.forEach(function(s) {
    if (s.lng != null && s.lat != null && (s.lng !== 0 || s.lat !== 0)) { cx += s.lng; cy += s.lat; cn++; }
  });
  return {
    n: middleName,
    m: middleName,
    r: feeder[0].mr || 0,
    mr: feeder[0].mr || 0,
    t: streets.join('/'),
    j: Object.keys(jwSet),
    c: Object.values(commMap),
    lng: cn > 0 ? cx / cn : (feeder[0] ? feeder[0].lng : null),
    lat: cn > 0 ? cy / cn : (feeder[0] ? feeder[0].lat : null),
    _isMiddleView: true,
    _feeders: feeder.map(function(s){ return {n: s.n, r: s.r}; })
  };
}

function renderMergedView(school, district) {
  selectedSchool = school;
  school.c.forEach(function(c) {
    if (c.lng != null && c.lat != null) {
      commCoords[commCacheKey(district, c.n)] = [c.lng, c.lat];
    }
  });
  // Pre-cache g.p scatter point coordinates (address-based districts)
  var g = school.g || {};
  (g.p || []).forEach(function(pt) {
    if (pt.lng != null && pt.lat != null) {
      commCoords[commCacheKey(district, pt.a)] = [pt.lng, pt.lat];
    }
  });
  updatePanelTitle();
  renderSchoolJuwei(school);
  renderCommunityList(school);
  zoomToMatchedJuwei(school);
  batchGeocode(school.c, district);
  if (showingSchoolMarkers) showSchoolMarkers();
}

// ---- Init ----
function initPage() {
  buildSearchIndex();
  var sel = document.getElementById('districtSel');
  var districts = Object.keys(schoolData.districts).sort();

  districts.forEach(function(d) {
    // Skip disabled districts per district_config.json
    if (Object.keys(districtConfig).length > 0 && districtConfig[d] && districtConfig[d].enabled === false) return;
    var count = schoolData.districts[d].length;
    var opt = document.createElement('option');
    opt.value = d;
    opt.textContent = d + ' (' + count + '所学校)';
    sel.appendChild(opt);
  });

  document.getElementById('panelSub').textContent = '学校 → 居委 → 小区';

  // Auto-select from URL params
  if (paramDistrict) {
    sel.value = paramDistrict;
    if (paramSchool) {
      currentMode = 'school';
    } else if (paramMiddle) {
      currentMode = 'middle';
    }
    onDistrictChange();

    if (currentMode === 'school') {
      var schools = schoolData.districts[paramDistrict] || [];
      var found = false;
      for (var i = 0; i < schools.length; i++) {
        if (schools[i].n === paramSchool) {
          document.getElementById('schoolSel').value = i;
          onSchoolChange();
          found = true;
          break;
        }
      }
      if (!found) {
        document.getElementById('panelSub').textContent = '未找到学校「' + paramSchool + '」的地图数据';
      }
    } else if (currentMode === 'middle') {
      var merged = buildMergedSchool(paramDistrict, paramMiddle);
      if (merged) {
        // Find and set middle selector value
        var midIdx = buildMiddleIndex(paramDistrict);
        for (var j = 0; j < midIdx.length; j++) {
          if (midIdx[j].n === paramMiddle || msMatch(midIdx[j].n, paramMiddle)) {
            document.getElementById('middleSel').value = j;
            break;
          }
        }
        renderMergedView(merged, paramDistrict);
      }
    }
  }
  showSchoolMarkers();
}

// ---- District change ----
function onDistrictChange() {
  var dist = document.getElementById('districtSel').value;
  var schoolSel = document.getElementById('schoolSel');
  var middleSel = document.getElementById('middleSel');

  clearSchoolJuwei();
  selectedSchool = null;
  selectedJuwei = null;
  document.getElementById('commList').innerHTML = '';
  document.getElementById('juweiTags').innerHTML = '';
  document.getElementById('infoCount').textContent = '';

  if (!dist) {
    schoolSel.style.display = 'none';
    middleSel.style.display = 'none';
    centerOn(paramLng || 121.47, paramLat || 31.23, paramLng && paramLat ? 15 : 11);
    if (showingSchoolMarkers) showSchoolMarkers();
    return;
  }

  // Build school dropdown — show对口初中+tier, keep街道, drop居委/小区 count
  var schools = schoolData.districts[dist] || [];
  schoolSel.innerHTML = '<option value="">选择学校...</option>';
  schools.forEach(function(s, i) {
    var opt = document.createElement('option');
    opt.value = i;
    var msRange = getMiddleTierRange(dist, s.m);
    var mInfo = s.m ? ' → ' + s.m + (msRange ? '[T' + msRange + ']' : '[T' + (s.mr > 0 ? s.mr : (s.mr === -1 ? '户籍' : '?')) + ']') : '';
    var tInfo = s.t ? ' · ' + s.t : '';
    opt.textContent = '[T' + s.r + '] ' + s.n + mInfo + tInfo;
    schoolSel.appendChild(opt);
  });

  // Build middle school dropdown
  var midList = buildMiddleIndex(dist);
  middleSel.innerHTML = '<option value="">选择初中...</option>';
  midList.forEach(function(m, i) {
    var opt = document.createElement('option');
    opt.value = i;
    var feederStr = m.feeders.length > 0 ? '（' + m.feeders.join('、') + '）' : '（特殊招生）';
    opt.textContent = '[T' + m.r + '] ' + m.n + ' ' + feederStr;
    middleSel.appendChild(opt);
  });

  // Show/hide based on mode
  if (currentMode === 'school') {
    schoolSel.style.display = 'block';
    middleSel.style.display = 'none';
  } else if (currentMode === 'middle') {
    schoolSel.style.display = 'none';
    middleSel.style.display = 'block';
  } else {
    // No mode set (manual district switch) — show both? default to school
    schoolSel.style.display = 'block';
    middleSel.style.display = 'block';
  }

  zoomToDistrict(dist);
  if (showingSchoolMarkers) showSchoolMarkers();
  document.getElementById('tabBar').style.display = 'none';
  updateBackBtn(dist);
}
function updateBackBtn(dist) {
  var btn = document.getElementById('backBtn');
  var params = [];
  if (dist) params.push('district=' + encodeURIComponent(dist));
  if (paramStreet) params.push('street=' + encodeURIComponent(paramStreet));
  if (paramTab) params.push('tab=' + encodeURIComponent(paramTab));
  btn.href = params.length > 0 ? '上海学区信息.html?' + params.join('&') : '上海学区信息.html';
}

function onSchoolChange() {
  var dist = document.getElementById('districtSel').value;
  var idx = document.getElementById('schoolSel').value;

  currentMode = 'school';
  document.getElementById('schoolSel').style.display = 'block';
  document.getElementById('middleSel').style.display = 'none';

  clearSchoolJuwei();
  selectedJuwei = null;

  if (!dist || idx === '') {
    selectedSchool = null;
    document.getElementById('commList').innerHTML = '';
    document.getElementById('juweiTags').innerHTML = '';
    document.getElementById('infoCount').textContent = '';
    document.getElementById('tabBar').style.display = 'none';
    closeDetail();
    if (showingSchoolMarkers) showSchoolMarkers();
    return;
  }

  selectedSchool = schoolData.districts[dist][parseInt(idx)];

  // Pre-cache coordinates from POI data (trusted source) — skip geocoding for these
  selectedSchool.c.forEach(function(c) {
    if (c.lng != null && c.lat != null) {
      commCoords[commCacheKey(dist, c.n)] = [c.lng, c.lat];
    }
  });
  // Pre-cache g.p scatter point coordinates
  var g = selectedSchool.g || {};
  (g.p || []).forEach(function(pt) {
    if (pt.lng != null && pt.lat != null) {
      commCoords[commCacheKey(dist, pt.a)] = [pt.lng, pt.lat];
    }
  });

  updatePanelTitle();
  renderSchoolJuwei(selectedSchool);
  renderCommunityList(selectedSchool);
  zoomToMatchedJuwei(selectedSchool);
  // Background batch geocoding — will skip communities already in cache
  batchGeocode(selectedSchool.c, dist);
  if (showingSchoolMarkers) showSchoolMarkers();
}

function onMiddleChange() {
  currentMode = 'middle';
  document.getElementById('middleSel').style.display = 'block';
  document.getElementById('schoolSel').style.display = 'none';

  var dist = document.getElementById('districtSel').value;
  var idx = document.getElementById('middleSel').value;

  clearSchoolJuwei();
  selectedJuwei = null;

  if (!dist || idx === '') {
    selectedSchool = null;
    document.getElementById('commList').innerHTML = '';
    document.getElementById('juweiTags').innerHTML = '';
    document.getElementById('infoCount').textContent = '';
    document.getElementById('tabBar').style.display = 'none';
    closeDetail();
    if (showingSchoolMarkers) showSchoolMarkers();
    return;
  }

  var midList = buildMiddleIndex(dist);
  var middleName = midList[parseInt(idx)].n;
  var merged = buildMergedSchool(dist, middleName);
  if (merged) renderMergedView(merged, dist);
}

function updatePanelTitle() {
  var s = selectedSchool;
  if (!s) return;
  var html;
  if (currentMode === 'middle' && s._isMiddleView) {
    // Mode 2: middle school entry — middle school name large + feeder schools with tiers
    var midBadge = '<span class="tier-badge tier-' + s.r + '">T' + s.r + '</span>';
    html = '<h2>' + midBadge + ' ' + escHtml(s.n) + ' <span class="hint">（对口学区）</span></h2>';
    if (s._feeders && s._feeders.length > 0) {
      html += '<div style="font-size:13px;margin-bottom:2px;font-weight:500;color:#1a1a2e">' +
        s._feeders.map(function(f) {
          return '<span class="tier-badge tier-' + f.r + '">T' + f.r + '</span> ' + escHtml(f.n);
        }).join(' · ') + '</div>';
    }
    var info = [];
    if (s.t) info.push('片区: ' + escHtml(s.t));
    html += '<div class="sub">' + info.join(' | ') + '</div>';
  } else {
    // Mode 1: school entry — school name + middle school name both large with tiers
    var schBadge = '<span class="tier-badge tier-' + s.r + '">T' + s.r + '</span>';
    var midInfo = '';
    if (s.m && s.m !== '') {
      var dist = document.getElementById('districtSel').value;
      var msRange = getMiddleTierRange(dist, s.m) || (s.mr > 0 ? s.mr : '户籍');
      midInfo = ' <span class="arrow">→</span> <span class="ms-name">' + escHtml(s.m) + '</span>' +
        ' <span class="tier-badge tier-' + String(msRange).split('-')[0] + '">T' + msRange + '</span>';
    }
    html = '<h2>' + schBadge + ' ' + escHtml(s.n) + midInfo + '</h2>';
    var info = [];
    if (s.t) info.push('片区: ' + escHtml(s.t));
    if (s.m && s.m !== '') info.push('对口: ' + escHtml(s.m));
    html += '<div class="sub">' + info.join(' | ') + '</div>';
  }
  document.getElementById('panelSub').innerHTML = html;
}

// ---- Render 居委 polygons ----
function jwKey(name) {
  return (name || '').replace(/居委会$/, '').replace(/居委$/, '');
}

function polygonMatchesJw(poly, jwName) {
  // jwName can be a school juwei name (e.g., 耀江(一)) or a geo-key (e.g., 耀江花园)
  if (poly._schoolJwNames && poly._schoolJwNames.indexOf(jwName) >= 0) return true;
  if (jwKey(poly._name) === jwKey(jwName)) return true;
  return false;
}

function resolveGeoJwKey(dist, schoolJwName) {
  // Look up the mapping to find the corresponding GeoJSON feature key
  var mapKey = dist + '|' + schoolJwName;
  var mapped = jwNameToGeoKey[mapKey];
  if (mapped) {
    return mapped.split('|')[1]; // geoJwKey
  }
  return jwKey(schoolJwName);
}

function renderSchoolJuwei(school) {
  var juweiNames = school.j;
  var dist = document.getElementById('districtSel').value;

  // 地址制: skip 居委/街道 polygons, show address scatter points only
  if (school.g && (school.g.p && school.g.p.length)) {
    setTimeout(function() { renderAddressGeo(school, dist); }, 800);
    return;
  }

  // Area-description only (g.l but no scatter/communities): nothing to draw on map
  if (school.g && school.g.l && school.g.l.length && !(school.c && school.c.length)) {
    return;
  }

  // 居委制: build reverse index geoJwKey → [schoolJwNames]
  var geoToSchoolJw = {};
  juweiNames.forEach(function(n) {
    var geoKey = resolveGeoJwKey(dist, n);
    if (!geoToSchoolJw[geoKey]) geoToSchoolJw[geoKey] = [];
    geoToSchoolJw[geoKey].push(n);
  });

  var matched = juweiFeatures.filter(function(f) {
    return f.properties['区'] === dist && geoToSchoolJw.hasOwnProperty(jwKey(f.properties.name));
  });

  matched.forEach(function(f) {
    var paths = getPolygonPaths(f);
    paths.forEach(function(path) {
      // Pre-calculate center from raw coordinates before AMap wraps them
      var lngSum = 0, latSum = 0;
      path.forEach(function(c) { lngSum += c[0]; latSum += c[1]; });
      var center = [lngSum / path.length, latSum / path.length];

      var p = new AMap.Polygon({
        path: path,
        fillColor: '#10b981',
        fillOpacity: 0.12,
        strokeColor: '#10b981',
        strokeWeight: 2,
        strokeOpacity: 0.7,
        zIndex: 20,
      });
      p._name = f.properties.name;
      p._street = f.properties['街道'] || '';
      p._juweiShort = f.properties.name.replace(/居委会$/, '');
      p._geoJwKey = jwKey(f.properties.name);
      p._schoolJwNames = geoToSchoolJw[p._geoJwKey] || [];
      p._center = center;
      p._isStreetFallback = false;
      p.setMap(map);
      schoolJuweiPolys.push(p);

      p.on('mouseover', function(e) {
        if (selectedJuwei && polygonMatchesJw(this, selectedJuwei)) return;
        this.setOptions({fillOpacity: 0.25, strokeWeight: 3, strokeOpacity: 1});
        showTooltip(e, this._juweiShort, '居委', this._street);
      });
      p.on('mousemove', function(e) { moveTooltip(e); });
      p.on('mouseout', function() {
        if (selectedJuwei && polygonMatchesJw(this, selectedJuwei)) return;
        if (hoverJuwei && polygonMatchesJw(this, hoverJuwei)) return;
        this.setOptions({fillOpacity: 0.12, strokeWeight: 2, strokeOpacity: 0.7});
        hideTooltip();
      });
      p.on('click', function(e) {
        var jwName = this._schoolJwNames.length > 0 ? this._schoolJwNames[0] : this._juweiShort;
        selectJuwei(jwName);
      });
    });
  });
}

function clearSchoolJuwei() {
  schoolJuweiPolys.forEach(function(p) { p.setMap(null); });
  schoolJuweiPolys = [];
  clearAddressGeo();
  selectedJuwei = null;
  hoverJuwei = null;
}

// ---- Address scatter / road highlight for 地段制 schools ----
var addrMarkers = [];

function renderRangePoints(school, dist) {
  clearAddressGeo();
  var pts = school.rp || [];
  pts.forEach(function(pt) {
    var addr = pt.address || '';
    var content = '<div style="position:relative;text-align:center">' +
      '<div style="width:7px;height:7px;background:#6366f1;border:1.5px solid #fff;border-radius:50%;margin:0 auto;box-shadow:0 1px 3px rgba(0,0,0,.5)"></div>' +
      '<div style="margin-top:1px;font-size:9px;color:#4338ca;background:rgba(255,255,255,.92);padding:0 3px;border-radius:2px;white-space:nowrap;max-width:120px;overflow:hidden;text-overflow:ellipsis">' + escHtml(addr) + '</div>' +
      '</div>';
    var m = new AMap.Marker({
      position: [pt.lng, pt.lat],
      content: content,
      anchor: 'top-center',
      offset: new AMap.Pixel(0, -3),
      zIndex: 104
    });
    m._rpAddr = addr;
    m.on('click', function() {
      commClickAddr(addr, dist, pt.lng, pt.lat);
    });
    m.on('mouseover', function() {
      commHover('', addr, dist);
    });
    m.on('mouseout', function() {
      commUnhover('');
    });
    m.setMap(map);
    addrMarkers.push(m);
  });
}

function clearAddressGeo() {
  addrMarkers.forEach(function(m) { m.setMap(null); });
  addrMarkers = [];
}

function renderAddressGeo(school, dist) {
  clearAddressGeo();
  var g = school.g;
  if (!g) return;

  // Render scatter points for 门牌地址
  var pts = g.p || [];
  pts.forEach(function(pt) {
    var content = '<div style="position:relative;text-align:center">' +
      '<div style="width:7px;height:7px;background:#f97316;border:1.5px solid #fff;border-radius:50%;margin:0 auto;box-shadow:0 1px 3px rgba(0,0,0,.5)"></div>' +
      '<div style="margin-top:1px;font-size:9px;color:#9a3412;background:rgba(255,255,255,.92);padding:0 3px;border-radius:2px;white-space:nowrap;max-width:120px;overflow:hidden;text-overflow:ellipsis">' + escHtml(pt.a) + '</div>' +
      '</div>';
    var m = new AMap.Marker({
      position: [pt.lng, pt.lat],
      content: content,
      anchor: 'top-center',
      offset: new AMap.Pixel(0, -3),
      zIndex: 105
    });
    m.on('click', function() {
      commClickAddr(pt.a, dist, pt.lng, pt.lat);
    });
    m.on('mouseover', function() {
      commHover('', pt.a, dist);
    });
    m.on('mouseout', function() {
      commUnhover('');
    });
    m.setMap(map);
    addrMarkers.push(m);
  });
}

function selectJuwei(jwName) {
  // jwName is a school juwei name (e.g., 耀江(一)) or any identifier matching c.j
  // Toggle
  if (selectedJuwei === jwName) {
    deselectJuwei();
    return;
  }

  // Deselect previous
  deselectJuweiPoly();
  selectedJuwei = jwName;

  // Highlight selected polygon(s) — use polygonMatchesJw for robust matching
  var matchedBounds = [];
  schoolJuweiPolys.forEach(function(p) {
    if (polygonMatchesJw(p, jwName)) {
      p.setOptions({
        fillColor: '#f59e0b',
        fillOpacity: 0.18,
        strokeColor: '#f59e0b',
        strokeWeight: 4,
        strokeOpacity: 0.9,
        zIndex: 30
      });
      var ppath = p.getPath();
      if (ppath && ppath.length > 0) {
        matchedBounds = matchedBounds.concat(ppath.map(function(c) { return [c.lng, c.lat]; }));
      }
    }
  });

  // Zoom to matched polygon(s)
  if (matchedBounds.length > 0) {
    map.setBounds(getBounds(matchedBounds), false, panelRightPadding(60));
  }

  // Update tags
  var tags = document.querySelectorAll('.juwei-tag');
  tags.forEach(function(t) {
    t.classList.toggle('active', t.textContent === jwName);
  });

  // Refresh community list to update tag states
  renderCommunityList(selectedSchool);
}

function deselectJuwei() {
  deselectJuweiPoly();
  selectedJuwei = null;
  var tags = document.querySelectorAll('.juwei-tag');
  tags.forEach(function(t) { t.classList.remove('active'); });
  renderCommunityList(selectedSchool);
}

function deselectJuweiPoly() {
  if (!selectedJuwei) return;
  schoolJuweiPolys.forEach(function(p) {
    if (polygonMatchesJw(p, selectedJuwei)) {
      p.setOptions({
        fillColor: '#10b981',
        fillOpacity: 0.12,
        strokeColor: '#10b981',
        strokeWeight: 2,
        strokeOpacity: 0.7,
        zIndex: 20
      });
    }
  });
}

// ---- Community hover / click → marker on map ----
var commMarker = null;

function getJuweiCenter(juweiShort) {
  for (var i = 0; i < schoolJuweiPolys.length; i++) {
    if (polygonMatchesJw(schoolJuweiPolys[i], juweiShort) && schoolJuweiPolys[i]._center) {
      return schoolJuweiPolys[i]._center;
    }
  }
  return null;
}

function getCachedCommCoords(name, district) {
  var ck = commCacheKey(district, name);
  return commCoords[ck] || null;
}

function getCommCoords(name, district, juweiShort) {
  var ck = commCacheKey(district, name);
  if (commCoords[ck]) return commCoords[ck];
  return getJuweiCenter(juweiShort);
}

function commHover(juweiShort, commName, district) {
  hoverJuwei = juweiShort;
  if (selectedJuwei && selectedJuwei !== juweiShort) {
    schoolJuweiPolys.forEach(function(p) {
      if (polygonMatchesJw(p, juweiShort)) {
        p.setOptions({fillOpacity: 0.25, strokeWeight: 3, strokeOpacity: 1});
      }
    });
  }
  // Show marker at community's own coordinates only — don't fall back to 居委 center
  var center = getCachedCommCoords(commName, district);
  if (center) {
    clearCommMarker();
    commMarker = new AMap.Marker({
      position: center,
      offset: new AMap.Pixel(-12, -32),
      zIndex: 100,
      content: '<div style="background:#f59e0b;color:#fff;padding:3px 8px;border-radius:12px;font-size:11px;box-shadow:0 2px 8px rgba(0,0,0,.35);white-space:nowrap"><b>' + escHtml(commName || juweiShort) + '</b></div>',
    });
    commMarker.setMap(map);
  }
  // Kick off geocoding if we haven't tried this community yet
  if (commCoords[commCacheKey(district, commName)] === undefined) {
    geocodeOne(commName, district, juweiShort);
  }
}

function commUnhover(juweiShort) {
  hoverJuwei = null;
  if (selectedJuwei && selectedJuwei === juweiShort) return;
  schoolJuweiPolys.forEach(function(p) {
    if (polygonMatchesJw(p, juweiShort)) {
      p.setOptions({fillOpacity: 0.12, strokeWeight: 2, strokeOpacity: 0.7});
    }
  });
  clearCommMarker();
}

function clearCommMarker() {
  if (commMarker) { commMarker.setMap(null); commMarker = null; }
}

function commClick(juweiShort, commName, district) {
  // Always select (never toggle) and zoom to 居委 (if 居委 info is available)
  var hasJuwei = !!juweiShort;
  if (hasJuwei && (!selectedJuwei || selectedJuwei !== juweiShort)) {
    deselectJuweiPoly();
    selectedJuwei = juweiShort;
    // Highlight polygon
    schoolJuweiPolys.forEach(function(p) {
      if (polygonMatchesJw(p, juweiShort)) {
        p.setOptions({
          fillColor: '#f59e0b', fillOpacity: 0.18,
          strokeColor: '#f59e0b', strokeWeight: 4, strokeOpacity: 0.9, zIndex: 30
        });
      }
    });
    // Update tags
    var tags = document.querySelectorAll('.juwei-tag');
    tags.forEach(function(t) {
      t.classList.toggle('active', t.textContent === juweiShort);
    });
  }
  // Refresh list
  renderCommunityList(selectedSchool);
  // Zoom to community coords if available, else 居委 bounds, else school center
  var center = getCommCoords(commName, district, juweiShort);
  if (center) {
    centerOn(center[0], center[1], 16);
  } else if (hasJuwei) {
    // Fallback: zoom to 居委 polygon(s)
    var fbounds = [];
    schoolJuweiPolys.forEach(function(p) {
      if (polygonMatchesJw(p, juweiShort)) {
        var ppath = p.getPath();
        if (ppath && ppath.length > 0) {
          fbounds = fbounds.concat(ppath.map(function(c) { return [c.lng, c.lat]; }));
        }
      }
    });
    if (fbounds.length > 0) {
      map.setBounds(getBounds(fbounds), false, panelRightPadding(60));
    } else if (selectedSchool && selectedSchool.lng != null && selectedSchool.lat != null) {
      centerOn(selectedSchool.lng, selectedSchool.lat, 15);
    }
  } else if (selectedSchool && selectedSchool.lng != null && selectedSchool.lat != null) {
    centerOn(selectedSchool.lng, selectedSchool.lat, 15);
  }
  // Show detail panel (desktop only — mobile keeps it hidden)
  if (!isMobile()) showCommDetail(commName);
}

function commClickAddr(addr, district, lng, lat) {
  selectedComm = null;
  centerOn(lng, lat, 17);
  if (!isMobile()) showAddrDetail(addr, district, lng, lat);
}

function showAddrDetail(addr, district, lng, lat) {
  selectedAddr = addr;
  var bar = document.getElementById('detailBar');
  var fav = isFavorite(district, addr);
  var html = '<h3>📍 ' + escHtml(addr) + '</h3>' +
    '<div class="d-row"><span class="d-label">坐标</span> ' + lng.toFixed(4) + ', ' + lat.toFixed(4) + '</div>' +
    '<div class="d-row"><span class="d-label">区</span> ' + escHtml(district) + '</div>' +
    '<div class="d-row"><span class="d-label">学校</span> ' + escHtml(selectedSchool ? selectedSchool.n : '') + '</div>' +
    '<div class="d-actions">' +
    '<button class="fav-btn2' + (fav ? ' active' : '') + '" onclick="toggleFavoriteAddr(\'' +
    escAttr(district) + '\',\'' + escAttr(selectedSchool ? selectedSchool.n : '') + '\',\'' + escAttr(addr) + '\')">' +
    (fav ? '★ 已收藏' : '☆ 收藏地址') + '</button>' +
    '<a class="lj-btn" href="' + buildLianjiaAddrUrl(addr) + '" onclick="openLj(this.href);return false" style="padding:4px 12px;font-size:11px">链家 →</a>' +
    '<button onclick="closeDetail()" style="background:none;border:1px solid #e2e8f0;border-radius:5px;padding:4px 10px;cursor:pointer;font-size:11px;color:#94a3b8">关闭</button>' +
    '</div>';
  bar.innerHTML = html;
  bar.classList.add('show');
  bar.scrollIntoView({behavior:'smooth',block:'nearest'});
}

// ---- Community list ----
function renderCommunityList(school) {
  if (!school) return;

  var dist = document.getElementById('districtSel').value;
  var isIncompleteDist = {}[dist];
  var g = school.g || {};
  var hasGData = (g.p && g.p.length) || (g.l && g.l.length);
  var isAddressScatter = hasGData && (!school.c || school.c.length === 0);

  if (isIncompleteDist) {
    document.getElementById('infoCount').textContent = '小区: 待补充';
    document.getElementById('tabBar').style.display = 'none';
    document.getElementById('juweiTags').innerHTML = '<span style="font-size:10px;color:#f59e0b">⚠️ 该区小区数据待补充，暂不显示小区清单</span>';
    document.getElementById('commList').innerHTML = '<div style="color:#999;text-align:center;padding:20px;line-height:1.6">该区小区数据待后续补充<br><small style="color:#aaa">学区范围待后续更新</small></div>';
    closeDetail();
    return;
  }

  if (isAddressScatter) {
    var pts = g.p || [];
    var areaDescs = school.j || [];
    var hasAreaDescs = areaDescs.length > 0;
    var hasScatterPts = pts.length > 0;

    var labelText = hasScatterPts ? '地址散点: ' + pts.length : '对口地段: ' + areaDescs.length + '条';
    document.getElementById('infoCount').textContent = labelText;
    document.getElementById('tabBar').style.display = 'flex';
    updateFavCount();

    var html = '';
    html += '<div style="max-height:60vh;overflow-y:auto;font-size:12px">';
    // Area descriptions (format objects like {路名, 范围[]})
    areaDescs.forEach(function(desc) {
      var text;
      if (typeof desc === 'object' && desc !== null) {
        text = escHtml(desc.路名 || '') + ': ' + (desc.范围 || []).join(', ');
      } else {
        text = escHtml(String(desc));
      }
      html += '<div style="padding:4px 6px;margin:2px 0;border-left:3px solid #93c5fd;background:#f8faff;color:#374151;border-radius:2px">📋 ' + text + '</div>';
    });
    // Scatter points — interactive: hover shows marker, click zooms + detail
    pts.forEach(function(p) {
      var addr = p.a || '';
      html += '<div class="comm-item"' +
        ' onmouseover="commHover(\'\',\'' + escAttr(addr) + '\',\'' + escAttr(dist) + '\')"' +
        ' onmouseout="commUnhover(\'\')"' +
        ' onclick="commClickAddr(\'' + escAttr(addr) + '\',\'' + escAttr(dist) + '\',' + p.lng + ',' + p.lat + ')">' +
        '<span class="cname" title="' + escAttr(addr) + '">📍 ' + escHtml(addr) + '</span>' +
        '<a class="lj-btn" href="' + buildLianjiaAddrUrl(addr) + '" onclick="openLj(this.href);event.stopPropagation();return false">链家→</a>' +
        '</div>';
    });
    html += '</div>';

    var tagHtml = '';
    if (hasAreaDescs) tagHtml += '<span style="font-size:10px;color:#6366f1">📋 对口地段</span>';
    if (hasScatterPts) {
      if (hasAreaDescs) tagHtml += ' ';
      tagHtml += '<span style="font-size:10px;color:#f97316">📍 对口门牌</span>';
    }
    document.getElementById('juweiTags').innerHTML = tagHtml;
    document.getElementById('commList').innerHTML = html;
    // Preserve detail if selected address still exists
    if (selectedAddr) {
      var stillExists = pts.some(function(p) { return p.a === selectedAddr; });
      if (stillExists) {
        var aPts = pts.filter(function(p) { return p.a === selectedAddr; });
        if (aPts.length > 0) showAddrDetail(selectedAddr, dist, aPts[0].lng, aPts[0].lat);
      } else {
        closeDetail();
      }
    } else {
      closeDetail();
    }
    return;
  }

  // Counts
  var hiddenCount = 0;
  school.c.forEach(function(c) {
    if (HIDDEN[c.n]) hiddenCount++;
  });

  // Determine if街道 fallback mode (地段制 without juwei matches)
  var isStreetFallback = schoolJuweiPolys.length > 0 && schoolJuweiPolys[0]._isStreetFallback;
  var schoolKey = dist + '|' + school.n;
  var streets = isStreetFallback ? (schoolStreetMap[schoolKey] || []) : [];

  var labelText = isStreetFallback
    ? '街道: ' + streets.length + ' | 小区: ' + school.c.length
    : (school.rp && school.rp.length)
      ? '路段: ' + school.rp.length + '个标记点 | 小区: ' + school.c.length
      : '居委: ' + school.j.length + ' | 小区: ' + school.c.length;
  document.getElementById('infoCount').textContent =
    labelText + (hiddenCount > 0 ? ' | 隐藏: ' + hiddenCount : '');

  // Show tab bar
  document.getElementById('tabBar').style.display = 'flex';
  updateFavCount();

  // 居委 tags
  var tagsHtml = '';
  var juweiShort = (school.j || []).map(function(n) { return typeof n === 'string' ? n.replace(/居委会$/, '').replace(/居委$/, '') : ''; }).filter(Boolean);
  if (school.rp && school.rp.length) {
    // Road-address school: show路段 indicator + j entries as clickable tags
    tagsHtml = '<span class="juwei-tag" style="background:#eef2ff;color:#4338ca;cursor:default;font-size:11px;opacity:0.85">📍 路段</span>';
    // Build set of j entries that have at least one community
    var jHasComm = {};
    juweiShort.forEach(function(jw) { jHasComm[jw] = false; });
    school.c.forEach(function(c) {
      var cj = (c.j || '').replace(/居委会$/, '').replace(/居委$/, '');
      if (jHasComm.hasOwnProperty(cj)) jHasComm[cj] = true;
    });
    juweiShort.forEach(function(jw) {
      var activeClass = (selectedJuwei && selectedJuwei.replace(/居委会$/, '') === jw) ? ' active' : '';
      if (jHasComm[jw]) {
        tagsHtml += '<span class="juwei-tag' + activeClass + '" onclick="onJuweiTagClick(\'' + escAttr(jw) + '\')">' + escHtml(jw) + '</span>';
      } else {
        tagsHtml += '<span class="juwei-tag tag-no-comm' + activeClass + '" onclick="onJuweiTagClick(\'' + escAttr(jw) + '\')" title="暂无匹配小区">' + escHtml(jw) + '</span>';
      }
    });
  } else if (isStreetFallback) {
    streets.forEach(function(st) {
      tagsHtml += '<span class="juwei-tag" style="background:#e0f2fe;color:#0369a1">' + escHtml(st) + '</span>';
    });
  } else {
    juweiShort.forEach(function(jw) {
      var activeClass = (selectedJuwei && selectedJuwei.replace(/居委会$/, '') === jw) ? ' active' : '';
      tagsHtml += '<span class="juwei-tag' + activeClass + '" onclick="onJuweiTagClick(\'' + escAttr(jw) + '\')">' + escHtml(jw) + '</span>';
    });
  }

  // 门牌号 group tag — shows alongside 居委/片区 tags
  var mpCount = 0;
  school.c.forEach(function(c) { if ((c.j || '').indexOf('门牌号') === 0) mpCount++; });
  if (mpCount > 0) {
    var mpActive = (selectedJuwei === '__menpaihao__') ? ' active' : '';
    tagsHtml += '<span class="juwei-tag' + mpActive + '" onclick="onJuweiTagClick(\'__menpaihao__\')">📍 门牌号 (' + mpCount + ')</span>';
  }

  document.getElementById('juweiTags').innerHTML = tagsHtml;

  // Community items — filter by selectedJuwei (居委/area entry, 门牌号 sentinel, or rp路段)
  var schoolJwEntries = (school.j || []).map(function(jn) {
    return (typeof jn === 'string' ? jn : '').replace(/居委会$/, '').replace(/居委$/, '');
  });
  var isRpSchool = school.rp && school.rp.length;
  var selectedShort = '';
  if ((!isStreetFallback || isRpSchool) && selectedJuwei) {
    if (selectedJuwei === '__menpaihao__') {
      selectedShort = '__menpaihao__';
    } else {
      var s = selectedJuwei.replace(/居委会$/, '').replace(/居委$/, '');
      if (schoolJwEntries.indexOf(s) >= 0) selectedShort = s;
    }
  }
  var html = '';
  var visibleCount = 0;
  school.c.forEach(function(c, i) {
    var isHidden = !!HIDDEN[c.n];
    var jw = (c.j || '').replace(/居委会$/, '').replace(/居委$/, '');
    var fav = isFavorite(dist, c.n);

    var filterHide = '';
    // Filter: 门牌号 sentinel shows only 门牌号 communities; 居委 filter shows only matching居委
    if (selectedShort === '__menpaihao__') {
      if ((c.j || '').indexOf('门牌号') !== 0) filterHide = ' hidden-row';
    } else if (selectedShort && jw && jw !== selectedShort) {
      filterHide = ' hidden-row';
    }
    if (!showHidden && isHidden) filterHide = ' hidden-row';

    if (filterHide.indexOf('hidden-row') < 0) visibleCount++;

    // In街道 fallback, show community address instead of area-range tag
    var showAddr = isStreetFallback;
    var tagDisplay = showAddr ? (typeof c.addr === 'string' ? c.addr.substring(0, 20) : '') : jw;
    var tooltipExtra = showAddr ? (typeof c.addr === 'string' ? c.addr : '') : jw;

    html += '<div class="comm-item' +
      (isHidden ? ' hidden-state' : '') + filterHide + '"' +
      ' id="comm-' + i + '"' +
      ' onmouseover="commHover(\'' + escAttr(jw) + '\',\'' + escAttr(c.n) + '\',\'' + escAttr(dist) + '\')"' +
      ' onmouseout="commUnhover(\'' + escAttr(jw) + '\')"' +
      ' onclick="commClick(\'' + escAttr(jw) + '\',\'' + escAttr(c.n) + '\',\'' + escAttr(dist) + '\')">' +
      '<span class="fav-star' + (fav ? ' active' : '') + '" onclick="event.stopPropagation();toggleFavorite(\'' +
      escAttr(dist) + '\',\'' + escAttr(school.n) + '\',\'' + escAttr(c.n) + '\',\'' +
      escAttr(jw) + '\',\'' + escAttr(String(c.y||'')) + '\',\'' + escAttr(String(c.t||'')) + '\',\'' +
      escAttr(String(c.p||'')) + '\',\'' + escAttr(c.u||'') + '\')" title="收藏">' + (fav ? '★' : '☆') + '</span>' +
      '<span class="cname" title="' + escAttr(c.n + (tooltipExtra ? ' · ' + tooltipExtra : '') + (c.addr && !isStreetFallback ? ' · ' + c.addr : '')) + '">' + escHtml(c.n) + '</span>' +
      (showAddr && tagDisplay ? '<span class="jtag" style="font-size:9px;max-width:100px;overflow:hidden;text-overflow:ellipsis">' + escHtml(tagDisplay) + '</span>' : '') +
      (!showAddr ? '<span class="jtag">' + escHtml(jw) + '</span>' : '') +
      '<button class="unhide-btn" onclick="event.stopPropagation();unhideComm(\'' + escAttr(c.n) + '\')">取消隐藏</button>' +
      '<button class="hide-btn" onclick="event.stopPropagation();hideComm(\'' + escAttr(c.n) + '\')">' + (isHidden ? '已隐藏' : '隐藏') + '</button>' +
      '<button class="fav-btn-mobile' + (fav ? ' active' : '') + '" onclick="event.stopPropagation();toggleFavorite(\'' +
      escAttr(dist) + '\',\'' + escAttr(school.n) + '\',\'' + escAttr(c.n) + '\',\'' +
      escAttr(jw) + '\',\'' + escAttr(String(c.y||'')) + '\',\'' + escAttr(String(c.t||'')) + '\',\'' +
      escAttr(String(c.p||'')) + '\',\'' + escAttr(c.u||'') + '\')">' + (fav ? '★' : '☆收藏') + '</button>' +
      '<a class="lj-btn" href="' + c.u + buildShHash(school, dist, c.u) + '" onclick="openLj(this.href);event.stopPropagation();return false">链家→</a>' +
      '</div>';
  });
  if (school.c.length === 0) {
    html = '<div style="color:#999;text-align:center;padding:12px">该学校对口范围暂无收录小区</div>';
  } else if (selectedJuwei && visibleCount === 0) {
    html = '<div style="color:#999;text-align:center;padding:24px 12px">该片区暂未搜索到具体房源<br><small style="color:#aaa">可尝试链家直接搜索</small></div>';
  }
  document.getElementById('commList').innerHTML = html;

  // Refresh detail bar if selected comm is still visible
  if (selectedComm) {
    var stillExists = school.c.some(function(c) { return c.n === selectedComm.n; });
    if (stillExists) showCommDetail(selectedComm.n);
    else closeDetail();
  }

  // Update tab bar state
  var btns = document.querySelectorAll('.tab-bar button');
  if (btns.length >= 2) {
    btns[0].classList.toggle('active', currentTab === 'list');
    btns[1].classList.toggle('active', currentTab === 'fav');
  }
}

function onJuweiTagClick(jw) {
  selectJuwei(jw);
}

function hideComm(name) {
  HIDDEN[name] = true;
  saveHidden();
  renderCommunityList(selectedSchool);
}

function unhideComm(name) {
  delete HIDDEN[name];
  saveHidden();
  renderCommunityList(selectedSchool);
}


// ---- Zoom ----
function zoomToDistrict(district) {
  var allCoords = [];
  juweiFeatures.forEach(function(f) {
    if (f.properties['区'] === district) {
      allCoords = allCoords.concat(getFirstRing(f));
    }
  });
  if (allCoords.length > 0) {
    map.setBounds(getBounds(allCoords), false, panelRightPadding(60));
  }
}

function zoomToMatchedJuwei(school) {
  var allCoords = [];

  // Use already-rendered polygon paths when available
  if (schoolJuweiPolys.length > 0) {
    schoolJuweiPolys.forEach(function(p) {
      var ppath = p.getPath();
      if (ppath && ppath.length > 0) {
        allCoords = allCoords.concat(ppath.map(function(c) { return [c.lng, c.lat]; }));
      }
    });
  }
  if (allCoords.length > 0) {
    map.setBounds(getBounds(allCoords), false, panelRightPadding(50));
    return;
  }

  // 地段制/地址制: zoom to scatter points + school location
  var g = school.g;
  var gCoords = [];
  if (g) {
    if (g.p && g.p.length > 0) {
      g.p.forEach(function(pt) { gCoords.push([pt.lng, pt.lat]); });
    }
  }
  // Fallback: use school's own coordinates
  if (gCoords.length === 0 && school.lng != null && school.lat != null) {
    gCoords.push([school.lng, school.lat]);
  }
  // Last resort: use g.l endpoints (approximate)
  if (gCoords.length === 0 && g && g.l && g.l.length > 0) {
    g.l.forEach(function(line) {
      line.path.forEach(function(c) { gCoords.push(c); });
    });
  }
  if (gCoords.length > 0) {
    var glngs = gCoords.map(function(c) { return c[0]; });
    var glats = gCoords.map(function(c) { return c[1]; });
    var minLng = Math.min.apply(null, glngs);
    var maxLng = Math.max.apply(null, glngs);
    var minLat = Math.min.apply(null, glats);
    var maxLat = Math.max.apply(null, glats);
    // Single point: add small buffer for reasonable zoom
    if (gCoords.length === 1) {
      var buf = 0.008; // ~800m
      minLng -= buf; maxLng += buf;
      minLat -= buf; maxLat += buf;
    }
    map.setBounds(
      new AMap.Bounds([minLng, minLat], [maxLng, maxLat]),
      false, panelRightPadding(40)
    );
    return;
  }

  // Fallback: zoom to school position + surrounding area
  if (school.lng != null && school.lat != null && (school.lng !== 0 || school.lat !== 0)) {
    centerOn(school.lng, school.lat, 15);
  }
}

// ---- Tooltip ----
function showTooltip(e, name, type, details) {
  var tip = document.getElementById('tooltip');
  tip.innerHTML = '<b>' + escHtml(name) + '</b><br><span style="color:#aaa;font-size:10px">' + escHtml(type) + (details ? ' · ' + escHtml(details) : '') + '</span>';
  tip.style.display = 'block';
  tip.style.left = (e.pixel.x + 14) + 'px';
  tip.style.top = (e.pixel.y - 42) + 'px';
}

function moveTooltip(e) {
  var tip = document.getElementById('tooltip');
  tip.style.left = (e.pixel.x + 14) + 'px';
  tip.style.top = (e.pixel.y - 42) + 'px';
}

function hideTooltip() {
  document.getElementById('tooltip').style.display = 'none';
}

// ---- Geo helpers ----
function getFirstRing(feature) {
  var geom = feature.geometry;
  if (geom.type === 'Polygon') return geom.coordinates[0];
  if (geom.type === 'MultiPolygon' && geom.coordinates.length > 0) return geom.coordinates[0][0];
  return [];
}

function getPolygonPaths(feature) {
  var geom = feature.geometry;
  var paths = [];
  if (geom.type === 'Polygon') {
    paths.push(geom.coordinates[0].map(function(c) { return [c[0], c[1]]; }));
  } else if (geom.type === 'MultiPolygon') {
    geom.coordinates.forEach(function(part) {
      paths.push(part[0].map(function(c) { return [c[0], c[1]]; }));
    });
  }
  return paths;
}

function getBounds(coords) {
  var minLng = Infinity, maxLng = -Infinity, minLat = Infinity, maxLat = -Infinity;
  coords.forEach(function(c) {
    if (c[0] < minLng) minLng = c[0];
    if (c[0] > maxLng) maxLng = c[0];
    if (c[1] < minLat) minLat = c[1];
    if (c[1] > maxLat) maxLat = c[1];
  });
  return new AMap.Bounds([minLng, minLat], [maxLng, maxLat]);
}

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function escAttr(s) {
  return String(s).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
}

// ---- Ring roads ----
function renderRings() {
  ringPolylines.forEach(function(p) { p.setMap(null); });
  ringLabels.forEach(function(l) { l.setMap(null); });
  ringPolylines = [];
  ringLabels = [];
  if (!showRings) return;

  ringFeatures.forEach(function(f) {
    var path = f.geometry.coordinates.map(function(c) { return [c[0], c[1]]; });
    var color = f.properties.color;
    var name = f.properties.label;
    var polyline = new AMap.Polyline({
      path: path, strokeColor: color, strokeWeight: 3, strokeOpacity: 0.7, zIndex: 2,
    });
    polyline.setMap(map);
    ringPolylines.push(polyline);
    var mid = path[Math.floor(path.length / 2)];
    var text = new AMap.Text({
      text: name, position: mid,
      style: {'background':color,'color':'#fff','padding':'2px 6px','border-radius':'4px','font-size':'11px','border':'none'},
      zIndex: 3,
    });
    text.setMap(map);
    ringLabels.push(text);
  });
}


function showSchoolMarkers() {
  hideSchoolMarkers();
  if (!schoolData) return;

  var tierColors = {1: '#10b981', 2: '#f59e0b', 3: '#ef4444'};
  var usedPositions = {}; // track positions to offset duplicates

  function addSchoolMarker(pos, name, tier, district, color, labelPrefix) {
    // Offset duplicate positions so overlapping markers are visible
    var posKey = pos[0].toFixed(6) + ',' + pos[1].toFixed(6);
    var n = usedPositions[posKey] || 0;
    usedPositions[posKey] = n + 1;
    if (n > 0) {
        var step = 0.002;
        var angles = [0, 45, 135, 225, 315, 90, 180, 270, 30, 150, 210, 330];
        var a = (angles[(n - 1) % angles.length] || n * 51) * Math.PI / 180;
        var r = step * (1 + Math.floor((n - 1) / angles.length));
        pos = [pos[0] + r * Math.cos(a), pos[1] + r * Math.sin(a)];
      }
    var label = (labelPrefix || '') + (tier ? 'T' + tier + ' ' : '') + name;
    var marker = new AMap.Marker({
      position: pos,
      content: '<div style="text-align:center">' +
        '<div style="width:10px;height:10px;background:' + color + ';border:2px solid #fff;border-radius:50%;margin:0 auto;box-shadow:0 1px 4px rgba(0,0,0,.4)"></div>' +
        '<div style="margin-top:1px;font-size:10px;color:#1a1a2e;background:rgba(255,255,255,.9);padding:1px 5px;border-radius:3px;white-space:nowrap;text-shadow:0 1px 0 #fff;font-weight:500;max-width:160px;overflow:hidden;text-overflow:ellipsis">' + escHtml(label) + '</div>' +
        '</div>',
      anchor: 'top-center',
      offset: new AMap.Pixel(0, -5),
      zIndex: 110
    });
    marker.on('click', function() {
      if (district) {
        document.getElementById('districtSel').value = district;
        onDistrictChange();
        setTimeout(function() {
          var sel = document.getElementById('schoolSel');
          for (var i = 0; i < sel.options.length; i++) {
            if (sel.options[i].text.indexOf(name) >= 0) {
              sel.value = sel.options[i].value;
              onSchoolChange();
              break;
            }
          }
        }, 300);
      }
    });
    marker.setMap(map);
    schoolMarkers.push(marker);
  }

  function centroidOf(schoolObj) {
    if (!schoolObj) return null;
    // Use school's own coordinates (precise geocoded address)
    if (schoolObj.lng != null && schoolObj.lat != null && (schoolObj.lng !== 0 || schoolObj.lat !== 0)) {
      return [schoolObj.lng, schoolObj.lat];
    }
    // Fallback to community centroids
    if (schoolObj.c && schoolObj.c.length) {
      var cx = 0, cy = 0, n = 0;
      schoolObj.c.forEach(function(c) {
        if (c.lng != null && c.lat != null) { cx += c.lng; cy += c.lat; n++; }
      });
      if (n > 0) return [cx / n, cy / n];
    }
    // Fallback to scatter points (地址制 schools)
    var g = schoolObj.g;
    if (g && g.p && g.p.length) {
      var gx = 0, gy = 0;
      g.p.forEach(function(p) { gx += p.lng; gy += p.lat; });
      return [gx / g.p.length, gy / g.p.length];
    }
    // Last resort: use g.l endpoints (approximate)
    if (g && g.l && g.l.length) {
      var lx = 0, ly = 0, ln = 0;
      g.l.forEach(function(l) {
        l.path.forEach(function(c) { lx += c[0]; ly += c[1]; ln++; });
      });
      if (ln > 0) return [lx / ln, ly / ln];
    }
    return null;
  }


  function getMiddlePos(name) {
    if (!name || !schoolData.middles) return null;
    if (schoolData.middles[name] && schoolData.middles[name].lng) {
      var m = schoolData.middles[name];
      return [m.lng, m.lat];
    }
    var clean = name.replace(/\([^)]*\)/g, '').trim();
    if (clean !== name && schoolData.middles[clean] && schoolData.middles[clean].lng) {
      var m = schoolData.middles[clean];
      return [m.lng, m.lat];
    }
    var keys = Object.keys(schoolData.middles);
    for (var i = 0; i < keys.length; i++) {
      var k = keys[i];
      var kClean = k.replace(/\([^)]*\)/g, '').trim();
      if (kClean === clean || clean.indexOf(kClean) >= 0 || kClean.indexOf(clean) >= 0) {
        if (schoolData.middles[k].lng) {
          var m = schoolData.middles[k];
          return [m.lng, m.lat];
        }
      }
    }
    return null;
  }

  // If a school is selected, show only that school + its对口初中
  if (selectedSchool) {
    var dist = document.getElementById('districtSel').value;
    if (selectedSchool._isMiddleView) {
      // Show middle school at geocoded position + feeder elementary schools
      var mPos = getMiddlePos(selectedSchool.n);
      if (mPos) addSchoolMarker(mPos, selectedSchool.n, selectedSchool.mr || 0, dist, tierColors[selectedSchool.mr] || '#8b5cf6', '初中: ');
      (selectedSchool._feeders || []).forEach(function(f) {
        var pt = centroidOf(getSchoolByName(dist, f.n));
        if (pt) addSchoolMarker(pt, f.n, f.r, dist, tierColors[f.r] || '#6b7280', '小学: ');
      });
    } else {
      // Show elementary school + its对口初中 at geocoded positions
      var schPt = centroidOf(selectedSchool);
      if (schPt) addSchoolMarker(schPt, selectedSchool.n, selectedSchool.r, dist, tierColors[selectedSchool.r] || '#6b7280', '');
      // Show对口初中 markers
      var mNames = (selectedSchool.m || '').split('/');
      mNames.forEach(function(mn) {
        mn = mn.trim();
        if (!mn) return;
        var mp = getMiddlePos(mn);
        if (mp) {
          // Try to find tier from school data
          var mTier = selectedSchool.mr || 0;
          addSchoolMarker(mp, mn, mTier, dist, tierColors[mTier] || '#8b5cf6', '初中: ');
        }
      });
    }
    return;
  }

  // No school selected — show all schools + middle schools in current district(s)
  var dist = document.getElementById('districtSel').value;
  var districts = dist ? [dist] : Object.keys(schoolData.districts).filter(function(d) {
    return !districtConfig[d] || districtConfig[d].enabled !== false;
  });


  districts.forEach(function(d) {
    var schools = schoolData.districts[d] || [];
    schools.forEach(function(s) {
      var pt = centroidOf(s);
      if (pt) addSchoolMarker(pt, s.n, s.r, d, tierColors[s.r] || '#6b7280', '');
    });
  });
}

function hideSchoolMarkers() {
  schoolMarkers.forEach(function(m) { m.setMap(null); });
  schoolMarkers = [];
}

// ---- Search ----
var searchIdx = [];  // {type, text, district, school, juwei, extra}
var searchHL = -1;

function buildSearchIndex() {
  searchIdx = [];
  // Schools
  Object.keys(schoolData.districts).forEach(function(dist) {
    (schoolData.districts[dist] || []).forEach(function(s) {
      searchIdx.push({type:'school', text:s.n, tier:s.r, district:dist, school:s, extra:(s.t||'')+' · T'+s.r});
    });
  });
  // Middle schools (from middles dict)
  if (schoolData.middles) {
    Object.keys(schoolData.middles).forEach(function(mName) {
      var m = schoolData.middles[mName];
      if (!m.lng) return;
      var dists = m.districts || [];
      var district = dists.length > 0 ? dists[0] : '';
      searchIdx.push({type:'middle', text:mName, tier:m.r||0, district:district, extra:(district||'')+' · T'+(m.r||'?')});
    });
  }

  // Streets (deduped)
  var stSet = {};
  Object.keys(schoolData.districts).forEach(function(dist) {
    (schoolData.districts[dist] || []).forEach(function(s) {
      if (s.t) { var k = dist+'|'+s.t; if (!stSet[k]) stSet[k] = {text:s.t, district:dist, cnt:0}; stSet[k].cnt++; }
    });
  });
  Object.values(stSet).forEach(function(st) {
    searchIdx.push({type:'street', text:st.text, district:st.district, extra:st.district+' · '+st.cnt+'所学校'});
  });
  // 居委
  juweiFeatures.forEach(function(f) {
    var street = f.properties['街道'] || '';
    searchIdx.push({type:'juwei', text:f.properties.name, district:f.properties['区'], extra:(f.properties['区']||'')+' · '+street});
  });
  // Communities
  Object.keys(schoolData.districts).forEach(function(dist) {
    (schoolData.districts[dist] || []).forEach(function(s) {
      (s.c || []).forEach(function(c) {
        searchIdx.push({type:'community', text:c.n, district:dist, school:s, juwei:c.j||'', extra:dist+' · '+s.n});
      });
    });
  });
}

function onSearchFocus() {
  var q = (document.getElementById('searchInput').value || '').trim();
  if (q.length >= 1) document.getElementById('searchDrop').classList.add('show');
}

function onSearchKey(e) {
  var drop = document.getElementById('searchDrop');
  if (!drop.classList.contains('show')) return;
  var items = drop.querySelectorAll('.s-item');
  if (e.key === 'ArrowDown') { e.preventDefault(); searchHL = Math.min(searchHL + 1, items.length - 1); updateSearchHL(items); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); searchHL = Math.max(searchHL - 1, -1); updateSearchHL(items); }
  else if (e.key === 'Enter') { e.preventDefault();
    if (searchHL >= 0 && items[searchHL]) { items[searchHL].click(); } }
  else if (e.key === 'Escape') { drop.classList.remove('show'); document.getElementById('searchInput').blur(); }
}

function updateSearchHL(items) {
  items.forEach(function(el, i) { el.classList.toggle('hl', i === searchHL); });
}

// Flattened result arrays for each group, keyed by spec key
var _searchGroups = null;

function onSearchInput() {
  var q = (document.getElementById('searchInput').value || '').trim();
  searchHL = -1;
  var drop = document.getElementById('searchDrop');
  if (q.length < 1) { drop.classList.remove('show'); _searchGroups = null; return; }
  var ql = q.toLowerCase();
  _searchGroups = {school:[], middle:[], street:[], juwei:[], community:[]};
  var limit = 6;
  for (var i = 0; i < searchIdx.length; i++) {
    var item = searchIdx[i];
    if (_searchGroups[item.type].length >= limit) continue;
    if (item.text.toLowerCase().indexOf(ql) >= 0 || (item.juwei && item.juwei.toLowerCase().indexOf(ql) >= 0)) {
      _searchGroups[item.type].push(item);
    }
  }
  var specs = [
    {key:'school', label:'小学', icon:'🏫'},
    {key:'middle', label:'初中', icon:'🎓'},
    {key:'street', label:'街道/片区', icon:'📍'},
    {key:'juwei', label:'居委', icon:'🏘'},
    {key:'community', label:'小区', icon:'🏠'}
  ];
  var html = '';
  specs.forEach(function(sp) {
    var list = _searchGroups[sp.key];
    if (list.length === 0) return;
    html += '<div class="sg-label">'+sp.icon+' '+sp.label+' ('+list.length+')</div>';
    list.forEach(function(item, idx) {
      html += '<div class="s-item" data-key="'+sp.key+'" data-idx="'+idx+'" onmousedown="selectSearchResult(\''+sp.key+'\','+idx+',event)">'+
        '<span class="si-type">'+sp.icon+'</span>'+
        '<span class="si-name">'+escHtml(item.text)+'</span>'+
        '<span class="si-ctx">'+escHtml(item.extra)+'</span>'+
        '</div>';
    });
  });
  if (!html) html = '<div class="s-empty">未找到匹配结果</div>';
  drop.innerHTML = html;
  drop.classList.add('show');
}

function selectSearchResult(key, idx, ev) {
  if (ev) ev.preventDefault();
  var item = _searchGroups[key][idx];
  if (!item) return;
  var drop = document.getElementById('searchDrop');
  drop.classList.remove('show');
  document.getElementById('searchInput').value = '';
  _searchGroups = null;

  if (key === 'school') {
    document.getElementById('districtSel').value = item.district;
    currentMode = 'school';
    onDistrictChange();
    setTimeout(function() {
      var sel = document.getElementById('schoolSel');
      for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].text.indexOf(item.text) >= 0) {
          sel.value = sel.options[i].value;
          onSchoolChange();
          return;
        }
      }
    }, 400);
  } else if (key === 'middle') {
    document.getElementById('districtSel').value = item.district;
    currentMode = 'middle';
    onDistrictChange();
    setTimeout(function() {
      var ml = document.getElementById('middleSel');
      var midList = buildMiddleIndex(item.district);
      for (var i = 0; i < midList.length; i++) {
        if (midList[i].n === item.text || msMatch(midList[i].n, item.text)) {
          ml.value = i;
          onMiddleChange();
          return;
        }
      }
    }, 400);
  } else if (key === 'street') {
    document.getElementById('districtSel').value = item.district;
    currentMode = 'school';
    onDistrictChange();
    centerOnStreet(item.district, item.text);
  } else if (key === 'juwei') {
    document.getElementById('districtSel').value = item.district;
    currentMode = 'school';
    onDistrictChange();
    // Try to find which school contains this居委
    var foundSchool = null;
    var jwShort = jwKey(item.text);
    var schools = schoolData.districts[item.district] || [];
    for (var si = 0; si < schools.length; si++) {
      var s = schools[si];
      for (var ji = 0; ji < (s.j||[]).length; ji++) {
        var geoKey = resolveGeoJwKey(item.district, s.j[ji]);
        if (geoKey === jwShort) { foundSchool = s; break; }
      }
      if (foundSchool) break;
    }
    if (foundSchool) {
      selectSchoolInCurrentDistrict(foundSchool);
    } else {
      // Just zoom to the居委 polygon
      zoomToJuweiByName(item.text, item.district);
    }
  } else if (key === 'community') {
    document.getElementById('districtSel').value = item.district;
    currentMode = 'school';
    onDistrictChange();
    if (item.school) {
      selectSchoolInCurrentDistrict(item.school, function() {
        // Zoom to the community
        setTimeout(function() {
          var coords = getCachedCommCoords(item.text, item.district);
          if (coords) {
            centerOn(coords[0], coords[1], 16);
            if (!isMobile()) {
              showCommDetail(item.text);
            }
          }
        }, 500);
      });
    }
  }
}

function selectSchoolInCurrentDistrict(schoolObj, cb) {
  var sel = document.getElementById('schoolSel');
  for (var i = 0; i < sel.options.length; i++) {
    if (sel.options[i].text.indexOf(schoolObj.n) >= 0) {
      sel.value = sel.options[i].value;
      onSchoolChange();
      if (cb) cb();
      return;
    }
  }
}

function centerOnStreet(district, street) {
  var coords = [];
  juweiFeatures.forEach(function(f) {
    if (f.properties['区'] === district && f.properties['街道'] === street) {
      coords = coords.concat(getFirstRing(f));
    }
  });
  if (coords.length > 0) {
    map.setBounds(getBounds(coords), false, panelRightPadding(60));
  }
}

function zoomToJuweiByName(jwFullName, district) {
  var short = jwKey(jwFullName);
  // Find matching features
  var coords = [];
  juweiFeatures.forEach(function(f) {
    if (f.properties['区'] === district && jwKey(f.properties.name) === short) {
      coords = coords.concat(getFirstRing(f));
    }
  });
  if (coords.length > 0) {
    map.setBounds(getBounds(coords), false, panelRightPadding(60));
    // Highlight the居委 polygon
    highlightJuweiPolyByName(short);
  }
}

function highlightJuweiPolyByName(jwShort) {
  deselectJuweiPoly();
  selectedJuwei = jwShort;
  schoolJuweiPolys.forEach(function(p) {
    if (polygonMatchesJw(p, jwShort)) {
      p.setOptions({
        fillColor:'#f59e0b', fillOpacity:0.18,
        strokeColor:'#f59e0b', strokeWeight:4, strokeOpacity:0.9, zIndex:30
      });
    }
  });
}

// Close search dropdown when clicking outside
document.addEventListener('click', function(e) {
  var wrap = document.getElementById('searchWrap');
  if (wrap && !wrap.contains(e.target)) {
    document.getElementById('searchDrop').classList.remove('show');
    _searchGroups = null;
  }
});


</script>
</body>
</html>
