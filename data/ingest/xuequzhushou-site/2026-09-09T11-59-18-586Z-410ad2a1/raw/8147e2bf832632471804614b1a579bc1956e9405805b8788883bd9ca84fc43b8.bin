  if (dataReady < 2) {
    loadingTimedOut = true;
    document.getElementById('loadingBar').style.opacity = '0';
    document.getElementById('panelSub').textContent = '数据加载超时 — 请通过 HTTP 服务器打开此页面（python3 -m http.server 8080）';
  }
}, 15000);

function updateLoading() {
  if (loadingTimedOut) return;
  document.getElementById('loadingBar').style.width = (dataReady / 2 * 100) + '%';
  if (dataReady >= 2) {
    setTimeout(function() { document.getElementById('loadingBar').style.opacity = '0'; }, 500);
    initPage();
  }
}

fetch('学区数据/上海居委会边界_简化版.json?v=20260624i')
  .then(function(r) { return r.json(); })
  .then(function(data) {
    var nonRes = /^(河道|楼宇|路面|道路|公共道路|绿地|广场)$|工业园|化工区|保税区|机场|码头|待开发|土控|废弃|处置场|农发公司|仓储|物流园区|路面/;
    juweiFeatures = data.features.filter(function(f) {
      if (f.properties['类型'] !== '其他') return true;
      return !nonRes.test(f.properties.name);
    });
    buildJuweiPolyIndex();
    dataReady += 1;
    updateLoading();
  })
  .catch(function(e) {
    console.error('居委边界数据加载失败:', e);
    dataReady += 1;
    updateLoading();
  });

