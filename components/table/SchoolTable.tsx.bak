"use client";

import { Fragment, useEffect, useMemo, useRef, useState } from "react";
import { useSelection } from "@/lib/store";
import { cn } from "@/lib/utils";
import type { CommunityApi } from "@/app/page";

const PAGE_SIZE = 60;

type School = {
  id: number;
  name: string;
  district: string;
  tier: string | null;
  type: "primary" | "middle" | "nine_year";
  address: string | null;
  enrollmentNote: string | null;
  recentScoreLine: string | null;
  pitRiskLevel: "low" | "medium" | "high" | "unknown" | null;
  attrs: Record<string, unknown> | null;
};

type SchoolAttrs = {
  shortName?: string;
  verified?: boolean;
  matching_committees?: string[];
  feeder_schools?: string[];
  enrollment_method?: string;
  school_nature?: string;
  middle_school_route?: string;
  policy_url?: string;
  data_source?: string;
};

const TYPE_LABEL: Record<School["type"], string> = {
  primary: "小学",
  middle: "初中",
  nine_year: "九年一贯",
};

const TIER_BADGE: Record<string, string> = {
  "一梯队": "bg-[var(--color-tier1-bg)] text-[var(--color-tier1)] border-[var(--color-tier1)]/20",
  "二梯队": "bg-[var(--color-tier2-bg)] text-[var(--color-tier2)] border-[var(--color-tier2)]/20",
  "三梯队": "bg-[var(--color-tier3-bg)] text-[var(--color-tier3)] border-[var(--color-tier3)]/20",
};

const RISK_BADGE: Record<NonNullable<School["pitRiskLevel"]>, string> = {
  low: "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20",
  medium: "bg-amber-500/10 text-amber-400 border border-amber-500/20",
  high: "bg-red-500/10 text-red-400 border border-red-500/20",
  unknown: "bg-[var(--color-bg-elev)] text-[var(--color-text-muted)] border border-[var(--color-border)]",
};

const RISK_LABEL: Record<NonNullable<School["pitRiskLevel"]>, string> = {
  low: "低",
  medium: "中",
  high: "高",
  unknown: "未知",
};

function lianjiaSearchUrl(schoolName: string) {
  return `https://sh.lianjia.com/ershoufang/rs${encodeURIComponent(schoolName)}/`;
}

function amapCommitteeSearchUrl(committee: string) {
  // 一键跳到高德搜该居委，方便人工核验它在地图上的位置
  const cleaned = committee.replace(/（部分）/g, "").trim();
  return `https://www.amap.com/search?query=${encodeURIComponent(`徐汇区${cleaned}居委会`)}`;
}

function amapSchoolSearchUrl(schoolName: string) {
  return `https://www.amap.com/search?query=${encodeURIComponent(schoolName)}`;
}

function amapPoiUrl(poiId: string | null, fallbackName: string) {
  if (poiId) return `https://www.amap.com/place/${poiId}`;
  return `https://www.amap.com/search?query=${encodeURIComponent(fallbackName)}`;
}

export function SchoolTable({
  schools,
  communities,
  communityStats,
  communitiesLoading,
}: {
  schools: School[] | undefined;
  communities?: CommunityApi[];
  communityStats?: { total: number; via_committee: number; via_feeder: number };
  communitiesLoading?: boolean;
}) {
  const selectedSchoolId = useSelection((s) => s.selectedSchoolId);
  const setSelectedSchool = useSelection((s) => s.setSelectedSchool);
  const hoveredSchoolId = useSelection((s) => s.hoveredSchoolId);
  const setHoveredSchool = useSelection((s) => s.setHoveredSchool);
  const rowRefs = useRef<Map<number, HTMLTableRowElement>>(new Map());

  // 选中行的 community 列表搜索 + 分页 (切换学校时重置)
  const [communitySearch, setCommunitySearch] = useState("");
  const [communityPage, setCommunityPage] = useState(0);
  useEffect(() => {
    setCommunitySearch("");
    setCommunityPage(0);
  }, [selectedSchoolId]);

  const filteredCommunities = useMemo(() => {
    if (!communities) return [];
    const q = communitySearch.trim().toLowerCase();
    if (!q) return communities;
    return communities.filter((c) =>
      c.name.toLowerCase().includes(q) ||
      (c.committeeName ?? "").toLowerCase().includes(q) ||
      (c.amapAddress ?? "").toLowerCase().includes(q),
    );
  }, [communities, communitySearch]);

  const pagedCommunities = useMemo(() => {
    const start = communityPage * PAGE_SIZE;
    return filteredCommunities.slice(start, start + PAGE_SIZE);
  }, [filteredCommunities, communityPage]);

  const totalPages = Math.max(1, Math.ceil(filteredCommunities.length / PAGE_SIZE));

  useEffect(() => {
    if (selectedSchoolId == null) return;
    const row = rowRefs.current.get(selectedSchoolId);
    if (row) {
      row.scrollIntoView({ block: "nearest", behavior: "smooth" });
    }
  }, [selectedSchoolId]);

  if (!schools) {
    return <div className="p-6 text-[var(--color-text-muted)] text-sm">加载中…</div>;
  }

  if (schools.length === 0) {
    return (
      <div className="p-6 text-[var(--color-text-muted)] text-sm">
        暂无数据。请先确认 PostgreSQL 服务已启动，且已通过安全导入或增量脚本写入数据。
      </div>
    );
  }

  return (
    <div className="overflow-auto h-full">
      <table className="w-full text-[13px]">
        <thead className="sticky top-0 bg-[var(--color-bg-elev)] border-b border-[var(--color-border)] text-[11px] text-[var(--color-text-muted)] font-mono-tiny">
          <tr>
            <th className="text-left px-3 py-2 font-medium">学校</th>
            <th className="text-left px-3 py-2 font-medium">类型</th>
            <th className="text-left px-3 py-2 font-medium">梯队</th>
            <th className="text-left px-3 py-2 font-medium">占坑风险</th>
            <th className="text-left px-3 py-2 font-medium">入学要求</th>
            <th className="text-left px-3 py-2 font-medium">近年录取</th>
            <th className="text-left px-3 py-2 font-medium">在售房源</th>
          </tr>
        </thead>
        <tbody>
          {schools.map((school) => {
            const isSelected = selectedSchoolId === school.id;
            const isHovered = hoveredSchoolId === school.id && !isSelected;
            const attrs = (school.attrs as SchoolAttrs | null) ?? {};
            const verified = attrs.verified ?? false;
            const committees = attrs.matching_committees ?? [];
            const feeders = attrs.feeder_schools ?? [];
            const policyUrl = attrs.policy_url;
            const enrollmentMethod = attrs.enrollment_method;
            const schoolNature = attrs.school_nature;
            return (
              <Fragment key={school.id}>
                <tr
                  ref={(el) => {
                    if (el) rowRefs.current.set(school.id, el);
                    else rowRefs.current.delete(school.id);
                  }}
                  onClick={() => setSelectedSchool(isSelected ? null : school.id)}
                  onMouseEnter={() => setHoveredSchool(school.id)}
                  onMouseLeave={() => setHoveredSchool(null)}
                  className={cn(
                    "border-b border-neutral-100 cursor-pointer transition-colors",
                    isSelected
                      ? "bg-blue-50 hover:bg-blue-100"
                      : isHovered
                        ? "bg-neutral-100"
                        : "hover:bg-neutral-50",
                  )}
                >
                  <td className="px-3 py-3 align-top">
                    <div className="font-medium text-neutral-900 leading-tight">{school.name}</div>
                    {school.address && (
                      <div className="text-xs text-neutral-500 mt-0.5">{school.address}</div>
                    )}
                    {!verified && (
                      <div className="inline-block mt-1 text-[10px] px-1.5 py-0.5 rounded bg-yellow-50 text-yellow-700 border border-yellow-200">
                        待核验
                      </div>
                    )}
                  </td>
                  <td className="px-3 py-3 align-top text-neutral-700">{TYPE_LABEL[school.type]}</td>
                  <td className="px-3 py-3 align-top">
                    {school.tier ? (
                      <span
                        className={cn(
                          "inline-block px-2 py-0.5 rounded text-xs border",
                          TIER_BADGE[school.tier] ?? "bg-neutral-100 text-neutral-700 border-neutral-200",
                        )}
                      >
                        {school.tier}
                      </span>
                    ) : (
                      <span className="text-neutral-400 text-xs">—</span>
                    )}
                  </td>
                  <td className="px-3 py-3 align-top">
                    <span
                      className={cn(
                        "inline-block px-2 py-0.5 rounded text-xs",
                        RISK_BADGE[school.pitRiskLevel ?? "unknown"],
                      )}
                    >
                      {RISK_LABEL[school.pitRiskLevel ?? "unknown"]}
                    </span>
                  </td>
                  <td className="px-3 py-3 align-top text-xs text-neutral-700 max-w-[260px]">
                    {school.enrollmentNote ?? "—"}
                  </td>
                  <td className="px-3 py-3 align-top text-xs text-neutral-700">
                    {school.recentScoreLine ?? "—"}
                  </td>
                  <td className="px-3 py-3 align-top">
                    <a
                      href={lianjiaSearchUrl(school.name)}
                      target="_blank"
                      rel="noopener noreferrer"
                      onClick={(e) => e.stopPropagation()}
                      className="text-blue-600 hover:text-blue-800 underline text-xs"
                    >
                      链家搜索 ↗
                    </a>
                  </td>
                </tr>
                {isSelected && (
                  <tr className="bg-blue-50/50 border-b border-blue-100">
                    <td colSpan={7} className="px-4 py-4">
                      <div className="space-y-3">
                        <div className="flex items-baseline gap-2 flex-wrap">
                          <span className="text-xs font-medium text-neutral-700">对口居委</span>
                          <span className="text-[10px] text-neutral-500">
                            ({committees.length} 个，来源:{" "}
                            {policyUrl ? (
                              <a
                                href={policyUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                onClick={(e) => e.stopPropagation()}
                                className="underline hover:text-blue-700"
                              >
                                {attrs.data_source ?? "见原文"}
                              </a>
                            ) : (
                              attrs.data_source ?? "—"
                            )}
                            )
                          </span>
                          <a
                            href={amapSchoolSearchUrl(school.name)}
                            target="_blank"
                            rel="noopener noreferrer"
                            onClick={(e) => e.stopPropagation()}
                            className="ml-auto text-[11px] text-blue-600 hover:text-blue-800 underline"
                          >
                            高德搜本校位置 ↗
                          </a>
                        </div>
                        {committees.length > 0 ? (
                          <div className="flex flex-wrap gap-1.5">
                            {committees.map((c) => (
                              <a
                                key={c}
                                href={amapCommitteeSearchUrl(c)}
                                target="_blank"
                                rel="noopener noreferrer"
                                onClick={(e) => e.stopPropagation()}
                                className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs bg-white border border-neutral-300 text-neutral-700 hover:bg-blue-100 hover:border-blue-300 hover:text-blue-700 transition-colors"
                                title={`点击在高德地图上搜「${c}居委会」核验位置`}
                              >
                                {c}
                              </a>
                            ))}
                          </div>
                        ) : (
                          <div className="text-xs text-neutral-500">该校无登记的对口居委</div>
                        )}

                        {feeders.length > 0 && (
                          <div>
                            <div className="text-xs font-medium text-neutral-700 mb-1.5">
                              {school.type === "middle" ? "对口小学（生源池）" : "可升入初中"}
                              <span className="ml-1 text-[10px] text-neutral-500">
                                ({feeders.length} 所)
                              </span>
                            </div>
                            <div className="flex flex-wrap gap-1.5">
                              {feeders.map((f) => (
                                <span
                                  key={f}
                                  className="inline-block px-2 py-0.5 rounded text-xs bg-white border border-neutral-200 text-neutral-600"
                                >
                                  {f}
                                </span>
                              ))}
                            </div>
                          </div>
                        )}

                        {/* 对口小区候选 */}
                        <div className="border-t border-blue-200 pt-3">
                          <div className="flex items-baseline gap-2 mb-2 flex-wrap">
                            <span className="text-xs font-medium text-neutral-700">对口小区候选</span>
                            {communitiesLoading ? (
                              <span className="text-[10px] text-neutral-500">加载中...</span>
                            ) : communityStats ? (
                              <span className="text-[10px] text-neutral-500">
                                ({communityStats.total} 个
                                {communityStats.via_committee > 0 && communityStats.via_feeder > 0 && (
                                  <> · 直接 {communityStats.via_committee} · 派生 {communityStats.via_feeder}</>
                                )}
                                {communityStats.via_feeder > 0 && communityStats.via_committee === 0 && (
                                  <> · 全部派生自对口小学</>
                                )}
                                ，全部 verified=false 待人工核验)
                              </span>
                            ) : (
                              <span className="text-[10px] text-neutral-500">(未加载)</span>
                            )}
                          </div>
                          {communities && communities.length > 0 ? (
                            <>
                              {communities.length > 30 && (
                                <div className="flex items-center gap-2 mb-1.5">
                                  <input
                                    type="text"
                                    value={communitySearch}
                                    onChange={(e) => {
                                      setCommunitySearch(e.target.value);
                                      setCommunityPage(0);
                                    }}
                                    onClick={(e) => e.stopPropagation()}
                                    placeholder="搜索小区/居委/地址..."
                                    className="text-xs px-2 py-1 border border-blue-200 rounded bg-white flex-1 min-w-0"
                                  />
                                  {filteredCommunities.length !== communities.length && (
                                    <span className="text-[10px] text-neutral-500 whitespace-nowrap">
                                      {filteredCommunities.length} / {communities.length}
                                    </span>
                                  )}
                                </div>
                              )}
                              <div className="max-h-48 overflow-y-auto pr-2 border border-blue-200 rounded bg-white p-2">
                                <div className="flex flex-wrap gap-1">
                                  {pagedCommunities.map((c) => {
                                    const isDerived = c.sourceName === "derived_via_feeder_school";
                                    return (
                                      <a
                                        key={c.linkId}
                                        href={amapPoiUrl(c.amapPoiId, c.name)}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        onClick={(e) => e.stopPropagation()}
                                        title={`${c.name}\n地址: ${c.amapAddress ?? "—"}\n来自: ${c.committeeName ?? c.sourceCommittee ?? "—"}\n来源: ${isDerived ? "派生（经由对口小学）" : "直接（居委周边）"}\n抓取日期: ${c.sourceDate}`}
                                        className={cn(
                                          "inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[11px] transition-colors",
                                          isDerived
                                            ? "bg-purple-50 border border-purple-200 text-purple-700 hover:bg-purple-100"
                                            : "bg-emerald-50 border border-emerald-200 text-emerald-700 hover:bg-emerald-100",
                                        )}
                                      >
                                        {c.name}
                                      </a>
                                    );
                                  })}
                                  {pagedCommunities.length === 0 && (
                                    <span className="text-xs text-neutral-500 italic">无匹配</span>
                                  )}
                                </div>
                              </div>
                              {totalPages > 1 && (
                                <div className="flex items-center justify-center gap-2 mt-1.5 text-[11px]">
                                  <button
                                    type="button"
                                    onClick={(e) => {
                                      e.stopPropagation();
                                      setCommunityPage((p) => Math.max(0, p - 1));
                                    }}
                                    disabled={communityPage === 0}
                                    className="px-2 py-0.5 rounded border border-neutral-300 bg-white disabled:opacity-40 hover:bg-neutral-50"
                                  >
                                    ← 上一页
                                  </button>
                                  <span className="text-neutral-600">
                                    第 {communityPage + 1} / {totalPages} 页
                                    <span className="text-neutral-400 ml-1">
                                      ({communityPage * PAGE_SIZE + 1}-
                                      {Math.min((communityPage + 1) * PAGE_SIZE, filteredCommunities.length)} of {filteredCommunities.length})
                                    </span>
                                  </span>
                                  <button
                                    type="button"
                                    onClick={(e) => {
                                      e.stopPropagation();
                                      setCommunityPage((p) => Math.min(totalPages - 1, p + 1));
                                    }}
                                    disabled={communityPage >= totalPages - 1}
                                    className="px-2 py-0.5 rounded border border-neutral-300 bg-white disabled:opacity-40 hover:bg-neutral-50"
                                  >
                                    下一页 →
                                  </button>
                                </div>
                              )}
                            </>
                          ) : !communitiesLoading && communityStats?.total === 0 ? (
                            <div className="text-xs text-neutral-500 italic">
                              该校无对口小区数据。
                              {school.type === "middle"
                                ? "该校所有 feeder_schools 暂未在 9 校之列，无法派生。"
                                : "matching_committees 可能为空。"}
                            </div>
                          ) : null}
                          {communities && communities.length > 0 && (
                            <div className="mt-1.5 flex items-center gap-3 text-[10px] text-neutral-500">
                              <span className="inline-flex items-center gap-1">
                                <span className="inline-block w-2 h-2 rounded-sm bg-emerald-300" />
                                直接（高德 PlaceSearch 反查居委）
                              </span>
                              <span className="inline-flex items-center gap-1">
                                <span className="inline-block w-2 h-2 rounded-sm bg-purple-300" />
                                派生（继承自对口小学）
                              </span>
                            </div>
                          )}
                        </div>

                        <div className="flex items-center gap-3 text-[11px] text-neutral-500 pt-1 border-t border-blue-200">
                          {schoolNature && <span>性质: {schoolNature}</span>}
                          {enrollmentMethod && <span>入学: {enrollmentMethod}</span>}
                          {policyUrl && (
                            <a
                              href={policyUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              onClick={(e) => e.stopPropagation()}
                              className="text-blue-600 hover:text-blue-800 underline"
                            >
                              查看原始招生政策 ↗
                            </a>
                          )}
                          <span className="ml-auto text-yellow-700">
                            ⚠ 小区数据 verified=false，需人工核验
                          </span>
                        </div>
                      </div>
                    </td>
                  </tr>
                )}
              </Fragment>
            );
          })}
        </tbody>
      </table>
    </div>
  );
}
